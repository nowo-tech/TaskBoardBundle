includes:
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon

parameters:
    level: 8
    paths:
        - src
    scanFiles:
        - tests/phpstan-stubs/App/Entity/User.php
        - tests/phpstan-stubs/Nowo/TiptapEditorBundle/Form/TiptapEditorType.php
        - tests/phpstan-stubs/Nowo/TagInputBundle/Form/TagType.php
    ignoreErrors: []
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
