# Test environment for the demo PHPUnit suite (REQ-DEMO-003). Committed on purpose: no real secrets.
# Loaded by Symfony Dotenv on top of .env when APP_ENV=test.

# APP_ENV: Symfony environment used by PHPUnit.
APP_ENV=test

# KERNEL_CLASS: Kernel booted by KernelTestCase / WebTestCase.
KERNEL_CLASS='App\Kernel'

# APP_SECRET: Placeholder secret for the test kernel (never reuse elsewhere).
APP_SECRET=change_this_secret_key_to_a_random_value
