<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <!-- The functional suite boots one kernel per configuration and renders every page -->
        <ini name="memory_limit" value="512M"/>
        <!-- REQ-SF-005: fail on direct Symfony deprecations -->
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="max[direct]=0"/>
        <!-- WebTestCase kernel (tests/Functional): the bundle on SQLite in memory, or TASK_BOARD_TEST_DATABASE_URL -->
        <server name="KERNEL_CLASS" value="Nowo\TaskBoardBundle\Tests\Functional\App\FunctionalKernel"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="functional">
            <directory>tests/Functional</directory>
        </testsuite>
    </testsuites>
    <source>
        <include><directory>src</directory></include>
        <exclude>
            <!-- Twig, translations, config and built assets: no PHP to measure. Nothing else is excluded (REQ-TEST-003):
                 Controller, Repository, Doctrine and Form are covered by the functional and repository tests. -->
            <directory>src/Resources</directory>
        </exclude>
    </source>
</phpunit>
