{% extends nowo_task_board_layout %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    <link rel="stylesheet" href="{{ asset('css/task-board.css', 'nowo_task_board') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/task-board.js', 'nowo_task_board') }}" defer></script>
{% endblock %}

{% block title %}{{ 'page.index'|trans({}, 'NowoTaskBoardBundle') }}{% endblock %}

{% block body %}
<h1>{{ 'page.index'|trans({}, 'NowoTaskBoardBundle') }}</h1>

<div class="card">
    <h2>{{ 'boards.title'|trans({}, 'NowoTaskBoardBundle') }}</h2>
    <ul>
        {% for board in boards %}
            <li>{{ board.name }}</li>
        {% else %}
            <li>{{ 'boards.empty'|trans({}, 'NowoTaskBoardBundle') }}</li>
        {% endfor %}
    </ul>
</div>

<div class="card">
    <h2>{{ 'tasks.trackable'|trans({}, 'NowoTaskBoardBundle') }}</h2>
    <ul>
        {% for task in tasks %}
            <li>
                {{ task.title }}
                <small>({{ task.totalTimeSeconds }}s)</small>
            </li>
        {% else %}
            <li>{{ 'tasks.empty'|trans({}, 'NowoTaskBoardBundle') }}</li>
        {% endfor %}
    </ul>
</div>
{% endblock %}
