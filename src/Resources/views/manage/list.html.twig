{% extends nowo_task_board_layout %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    <link rel="stylesheet" href="{{ asset('css/task-board.css', 'nowo_task_board') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/task-board.js', 'nowo_task_board') }}" defer></script>
{% endblock %}

{% block title %}{{ board.name }} — {{ 'task_board.list.title'|trans({}, 'NowoTaskBoardBundle') }}{% endblock %}

{% block container_class %}container container-wide{% endblock %}

{% block body %}
    {% block nowo_task_board_toolbar %}
    {{ include('@NowoTaskBoardBundle/manage/_page_header.html.twig', {
        pageTitle: board.name ~ ' — ' ~ ('task_board.list.title'|trans({}, 'NowoTaskBoardBundle')),
        breadcrumbRoute: nowo_task_board_route('board'),
        breadcrumbParams: {boardId: board.id},
        breadcrumbLabel: board.name,
        headerActions: [
            {href: path(nowo_task_board_route('board'), {boardId: board.id}), icon: 'layout-kanban', label: 'task_board.view.board'|trans({}, 'NowoTaskBoardBundle'), class: 'btn-outline-primary'},
            {href: path(nowo_task_board_route('gantt'), {boardId: board.id}), icon: 'chart-bar', label: 'task_board.view.gantt'|trans({}, 'NowoTaskBoardBundle'), class: 'btn-outline-primary'},
        ],
        dashboardRoute: dashboardRoute|default(null),
    }) }}
    {% endblock %}

    {% block nowo_task_board_list %}
    {#
        Since 1.12 (ClickUp-like): the filters in one row, then one collapsible group per column (its colour, icon and
        count) with the tasks as rows — title, assignees, due date, priority, tags — and an inline "+ New task" for the
        editors. Tasks without a column close the list. The client-side filters keep their targets (data-title,
        data-priority, data-column on every row).
    #}
    {% import '@NowoTaskBoardBundle/manage/_task_member_label.html.twig' as memberUi %}
    <div class="nowo-task-list" data-controller="nowo-task-board-list-filter" data-nowo-task-board-list-filter-board-value="{{ board.id }}">
        {% if nowo_task_board_filters_collapse|default(null) %}
            {#
                Since 1.17: the host folds the filters its own way (templates.filters_collapse, e.g. UiKit's corner tab),
                as the first child of the form, on the host's filter card (templates.filters_form_class).
            #}
            {% set _tb_filters_class = ('nowo-task-board-list-filters nowo-task-list__filters ' ~ nowo_task_board_filters_form_class|default(''))|trim %}
            {{ form_start(filterForm, {attr: filterForm.vars.attr|merge({class: _tb_filters_class, 'aria-label': 'task_board.list.filters'|trans({}, 'NowoTaskBoardBundle')})}) }}
                {{ include(nowo_task_board_filters_collapse, {key: 'nowo-task-board-list-' ~ board.id, fold_key: 'nowo-task-board-list-' ~ board.id, form: filterForm, filter_form: filterForm}) }}
                {% for child in filterForm %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(filterForm) }}
        {% else %}
            {#
                Since 1.15 the filters fold behind a "Filters" toggle (state per board in localStorage, open while a filter
                is active, the disclosure chevron of the host's icon set) and gain "Over estimate" and the time columns.
            #}
            <div class="nowo-task-list__filter-panel" data-controller="nowo-task-board-filter-collapse" data-nowo-task-board-filter-collapse-id-value="{{ board.id }}">
                <button type="button" class="nowo-task-list__filter-toggle" data-nowo-task-board-filter-collapse-target="button" data-action="nowo-task-board-filter-collapse#toggle" data-controller="disclosure-icon" aria-expanded="true" aria-controls="nowo-task-list-filters-{{ board.id }}">
                    {{ include('@NowoTaskBoardBundle/manage/_disclosure.html.twig', {class: 'nowo-task-list__filter-caret'}) }}
                    {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'filter'}) }}
                    <span>{{ 'task_board.list.filters'|trans({}, 'NowoTaskBoardBundle') }}</span>
                    <span class="nowo-task-list__filter-count" data-nowo-task-board-filter-collapse-target="count" hidden></span>
                </button>
                <div class="nowo-task-list__filter-body" id="nowo-task-list-filters-{{ board.id }}" data-nowo-task-board-filter-collapse-target="body">
                    {# REQ-TWIG-005: client-side filters (unmapped TaskListFilterType fields keep the Stimulus targets). #}
                    {{ form_start(filterForm, {attr: filterForm.vars.attr|merge({class: 'nowo-task-board-list-filters nowo-task-list__filters', 'aria-label': 'task_board.list.filters'|trans({}, 'NowoTaskBoardBundle')})}) }}
                        {% for child in filterForm %}
                            {% if not child.rendered %}
                                {{ form_row(child) }}
                            {% endif %}
                        {% endfor %}
                    {{ form_end(filterForm) }}
                </div>
            </div>
        {% endif %}

        {% set _groups = board.columns|map(c => {column: c, tasks: tasks|filter(t => t.column and t.column.id == c.id)}) %}
        {% set _orphans = tasks|filter(t => not t.column) %}
        {% if _orphans is not empty %}
            {% set _groups = _groups|merge([{column: null, tasks: _orphans}]) %}
        {% endif %}
        {% for group in _groups %}
            {% set _color = group.column ? group.column.color|nowo_task_board_safe_color : null %}
            {#
                Since 1.13 the groups fold with UiKit's collapse-panel peer (state per board and column in localStorage,
                the disclosure chevron of the host's icon set); without the peer registered they stay open.
            #}
            <section class="nowo-task-list__group{{ _color ? ' nowo-task-list__group--colored' : '' }}"
                data-controller="collapse-panel"
                data-collapse-panel-id-value="{{ board.id }}-{{ group.column ? group.column.id : 'none' }}"
                data-collapse-panel-storage-key-value="nowo-task-board.list-groups"
                {% if _color %}data-nowo-task-vars="{{ {'--nowo-task-column-color': _color}|json_encode }}"{% endif %}>
                <button type="button" class="nowo-task-list__group-header" data-collapse-panel-target="button" data-action="collapse-panel#toggle" data-controller="disclosure-icon" aria-expanded="true">
                    {% set _set = nowo_ui_kit_icon_set|default('tabler-icons') %}
                    {{ include('@NowoUiKitBundle/partials/_disclosure_icon.html.twig', {
                        class: 'nowo-task-list__group-caret',
                        morph: true,
                        icons: _set == 'ux_icon' ? {open: 'tabler:chevron-down', closed: 'tabler:chevron-right'} : {},
                    }, false, true) }}
                    <span class="nowo-task-list__group-name">
                        {% if group.column %}
                            {{ include('@NowoTaskBoardBundle/manage/_column_icon.html.twig', {icon: group.column.icon}) }}{{ group.column.name }}
                        {% else %}
                            {{ 'task_board.task.no_column'|trans({}, 'NowoTaskBoardBundle') }}
                        {% endif %}
                    </span>
                    <span class="nowo-task-list__group-count">{{ group.tasks|length }}</span>
                </button>
                <div class="nowo-task-list__group-body" data-collapse-panel-target="body">
                <div class="nowo-task-list__table-wrap">
                    <table class="nowo-task-list__table">
                        <thead>
                            <tr>
                                <th scope="col">{{ 'task_board.form.task.title'|trans({}, 'NowoTaskBoardBundle') }}</th>
                                <th scope="col">{{ 'task_board.task.people'|trans({}, 'NowoTaskBoardBundle') }}</th>
                                <th scope="col">{{ 'task_board.form.task.due'|trans({}, 'NowoTaskBoardBundle') }}</th>
                                <th scope="col">{{ 'task_board.form.task.priority'|trans({}, 'NowoTaskBoardBundle') }}</th>
                                <th scope="col">{{ 'task_board.form.task.tags'|trans({}, 'NowoTaskBoardBundle') }}</th>
                                {# Since 1.15: optional time columns ("Show time" in the filters). #}
                                <th scope="col" class="nowo-task-list__time-col nowo-task-list__num">{{ 'task_board.time.estimate'|trans({}, 'NowoTaskBoardBundle') }}</th>
                                <th scope="col" class="nowo-task-list__time-col nowo-task-list__num">{{ 'task_board.time.spent'|trans({}, 'NowoTaskBoardBundle') }}</th>
                                <th scope="col" class="nowo-task-list__time-col nowo-task-list__num">{{ 'task_board.time.deviation'|trans({}, 'NowoTaskBoardBundle') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for task in group.tasks %}
                                {% set _deviation = nowo_task_board_deviation(task) %}
                                <tr
                                    data-nowo-task-board-list-filter-target="row"
                                    data-title="{{ task.title }}"
                                    data-priority="{{ task.priority.value }}"
                                    data-column="{{ task.column ? task.column.name : '' }}"
                                    data-column-name="{{ task.column ? task.column.name : '' }}"
                                    data-due="{{ task.dueAt ? task.dueAt|date('Y-m-d') : '' }}"
                                    data-task-id="{{ task.id }}"
                                    data-estimate="{{ _deviation.hasEstimate ? _deviation.estimatedMinutes : '' }}"
                                    data-spent="{{ _deviation.spentMinutes }}"
                                    data-over="{{ _deviation.over ? '1' : '0' }}"
                                    data-task-panel-url="{{ path(nowo_task_board_route('task_panel'), {taskId: task.id}|merge(panelTargetPath|default(null) ? {_target_path: panelTargetPath} : {})) }}"
                                    class="nowo-task-list__row{{ task.completed ? ' is-done' : '' }}"
                                >
                                    <td>
                                        <span class="nowo-task-list__title">
                                            <span class="nowo-task-list__status-dot" aria-hidden="true"></span>
                                            <a href="{{ path(nowo_task_board_route('task'), {taskId: task.id, from: 'list'}) }}">{{ task.title }}</a>
                                            {% set _comments = (commentCounts|default({}))[task.id] ?? 0 %}
                                            {% if _comments > 0 %}
                                                <span class="nowo-task-list__comments" title="{{ 'task_board.comment.count_n'|trans({'%count%': _comments}, 'NowoTaskBoardBundle') }}">{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'message-circle'}) }}{{ _comments }}<span class="nowo-task-sr-only"> {{ 'task_board.comment.count_n'|trans({'%count%': _comments}, 'NowoTaskBoardBundle') }}</span></span>
                                            {% endif %}
                                        </span>
                                    </td>
                                    <td>
                                        <span class="nowo-task-avatars">
                                            {% for member in task.members|slice(0, 3) %}
                                                {% set _name = memberUi.member_label(member.user)|trim %}
                                                <span class="nowo-task-avatar" title="{{ _name }}">{{ _name|slice(0, 1)|upper }}</span>
                                            {% else %}
                                                <span class="nowo-task-list__none">—</span>
                                            {% endfor %}
                                        </span>
                                    </td>
                                    <td class="nowo-task-list__date">
                                        {% if task.dueAt %}
                                            <time datetime="{{ task.dueAt|date('Y-m-d') }}" class="{{ not task.completed and task.dueAt|date('Y-m-d') < 'now'|date('Y-m-d') ? 'is-late' : '' }}">{{ task.dueAt|date('Y-m-d') }}</time>
                                        {% else %}
                                            <span class="nowo-task-list__none">—</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="nowo-task-priority nowo-task-priority--{{ task.priority.value }}">{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'flag'}) }}{{ ('task_board.priority.' ~ task.priority.value)|trans({}, 'NowoTaskBoardBundle') }}</span>
                                    </td>
                                    <td>{{ include('@NowoTaskBoardBundle/manage/_task_tags.html.twig', {tags: task.tags}) }}</td>
                                    <td class="nowo-task-list__time-col nowo-task-list__num">{{ _deviation.hasEstimate ? _deviation.estimatedMinutes|nowo_task_board_duration : '—' }}</td>
                                    <td class="nowo-task-list__time-col nowo-task-list__num">{{ _deviation.spentMinutes|nowo_task_board_duration }}</td>
                                    <td class="nowo-task-list__time-col nowo-task-list__num">
                                        {% if _deviation.hasEstimate %}
                                            <span class="nowo-task-deviation-pill nowo-task-deviation-pill--{{ _deviation.status }}" title="{{ ('task_board.time.status.' ~ _deviation.status)|trans({}, 'NowoTaskBoardBundle') }}">{{ _deviation.difference|nowo_task_board_duration(true) }} ({{ _deviation.percent > 0 ? '+' : '' }}{{ _deviation.percent }} %)</span>
                                        {% else %}
                                            <span class="nowo-task-list__none">—</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr class="nowo-task-list__empty"><td colspan="8">{{ 'task_board.board.column_empty'|trans({}, 'NowoTaskBoardBundle') }}</td></tr>
                            {% endfor %}
                        </tbody>
                        {% if group.tasks is not empty %}
                            {# Since 1.15: the totals of the rows the filters show (kept up to date by the list filter controller). #}
                            <tfoot class="nowo-task-list__time-col" data-nowo-task-board-list-filter-target="totals">
                                <tr>
                                    <th scope="row" colspan="5">{{ 'task_board.list.total_shown'|trans({}, 'NowoTaskBoardBundle') }}</th>
                                    <td class="nowo-task-list__num" data-total="estimate">—</td>
                                    <td class="nowo-task-list__num" data-total="spent">—</td>
                                    <td class="nowo-task-list__num" data-total="deviation">—</td>
                                </tr>
                            </tfoot>
                        {% endif %}
                    </table>
                </div>
                {% if group.column and (canEditBoard ?? false) and inlineTaskForms[group.column.id] is defined %}
                    {{ include('@NowoTaskBoardBundle/manage/_inline_task_add.html.twig', {form: inlineTaskForms[group.column.id]}) }}
                {% endif %}
                </div>
            </section>
        {% else %}
            <p class="nowo-task-list__empty">{{ 'task_board.list.empty'|trans({}, 'NowoTaskBoardBundle') }}</p>
        {% endfor %}

        {% if tasks is not empty %}
            <dl class="nowo-task-list__totals nowo-task-list__time-col" data-nowo-task-board-list-filter-target="totals" aria-label="{{ 'task_board.list.total_shown'|trans({}, 'NowoTaskBoardBundle') }}">
                <div><dt>{{ 'task_board.list.total_shown'|trans({}, 'NowoTaskBoardBundle') }} · {{ 'task_board.time.estimate'|trans({}, 'NowoTaskBoardBundle') }}</dt><dd data-total="estimate">—</dd></div>
                <div><dt>{{ 'task_board.time.spent'|trans({}, 'NowoTaskBoardBundle') }}</dt><dd data-total="spent">—</dd></div>
                <div><dt>{{ 'task_board.time.deviation'|trans({}, 'NowoTaskBoardBundle') }}</dt><dd data-total="deviation">—</dd></div>
            </dl>
        {% endif %}
    </div>
    {% endblock %}
{% endblock %}
