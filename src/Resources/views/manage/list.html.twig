{% extends nowo_task_board_page_layout() ?? nowo_ui_layout.admin %}
{% set nowo_ui_bundle = 'NowoTaskBoardBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/task-board.css', 'nowo_task_board') }}">
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('js/nowo-ui-tree.js', 'nowo_ui_kit') }}" defer></script>
    {% if nowo_task_board_numbers_enabled() %}<script src="{{ asset('js/nowo-ui-clipboard.js', 'nowo_ui_kit') }}" defer></script>{% endif %}<script src="{{ asset('js/task-board.js', 'nowo_task_board') }}" defer></script>
{% endblock %}

{% block nowo_ui_document_title %}{{ board.name }} — {{ 'task_board.list.title'|trans({}, 'NowoTaskBoardBundle') }}{% endblock %}

{% block nowo_ui_page_header %}
    {% if nowo_task_board_ui.page_header %}{% block nowo_task_board_toolbar %}
    {{ nowo_ui_page_header(nowo_task_board_header({
        title: board.name ~ ' — ' ~ ('task_board.list.title'|trans({}, 'NowoTaskBoardBundle')),
        crumb: {href: path(nowo_task_board_route('board'), {boardId: board.id}), label: (board.icon ? board.icon ~ ' ' : '') ~ board.name},
        tabs: [
            {href: path(nowo_task_board_route('board'), {boardId: board.id, view: 'board'}), icon: 'layout-kanban', label: 'task_board.view.board'|trans({}, 'NowoTaskBoardBundle')},
            {href: path(nowo_task_board_route('list'), {boardId: board.id}), icon: 'list', label: 'task_board.view.list'|trans({}, 'NowoTaskBoardBundle'), active: true},
            {href: path(nowo_task_board_route('gantt'), {boardId: board.id}), icon: 'chart-bar', label: 'task_board.view.gantt'|trans({}, 'NowoTaskBoardBundle')},
        ]|merge(nowo_task_board_calendar_tabs(board, 'task_board.view.calendar'|trans({}, 'NowoTaskBoardBundle'))),
        back: dashboardRoute|default(null) ? path(dashboardRoute) : null,
    })) }}
    {% endblock %}{% endif %}
{% endblock %}

{% block nowo_ui_content %}

    {# Since 1.23: the board's provider connection (badge, Refresh, Connect provider); nothing without sync. #}
    {% block nowo_task_board_connection %}
        {{ include(nowo_task_board_connection_badge_template|default('@NowoTaskBoardBundle/manage/_connection_badge.html.twig'), {sync: nowo_task_board_connection(board)}) }}
    {% endblock %}

    {{ include('@NowoTaskBoardBundle/manage/_task_window_notice.html.twig') }}

    {% block nowo_task_board_list %}
    {#
        Since 1.12 (ClickUp-like): the filters in one row, then one collapsible group per column (its colour, icon and
        count) with the tasks as rows — title, assignees, due date, priority, tags — and an inline "+ New task" for the
        editors. Tasks without a column close the list. The client-side filters keep their targets (data-title,
        data-priority, data-column on every row).
    #}
    {% import '@NowoTaskBoardBundle/manage/_task_member_label.html.twig' as memberUi %}
    <div class="nowo-task-list" data-controller="nowo-task-board-list-filter" data-nowo-task-board-list-filter-board-value="{{ board.id }}">
        {#
            Since 2.0.0 UiKit's fold driven by the bundle (no host peer needed); templates.filters_collapse replaces it,
            templates.filters_form_class adds the host's classes to the form.
        #}
        {% set _tb_filters_class = ('nowo-ui-filter-bar nowo-task-board-list-filters nowo-task-list__filters ' ~ nowo_task_board_filters_form_class|default(''))|trim %}
        {{ form_start(filterForm, {attr: filterForm.vars.attr|merge({class: _tb_filters_class, 'aria-label': 'task_board.list.filters'|trans({}, 'NowoTaskBoardBundle')})}) }}
            {{ include(nowo_task_board_filters_collapse|default('@NowoTaskBoardBundle/manage/_list_filter_fold.html.twig'), {key: 'nowo-task-board-list-' ~ board.id, fold_key: 'nowo-task-board-list-' ~ board.id, form: filterForm, filter_form: filterForm}) }}
            {% for child in filterForm %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        {{ form_end(filterForm) }}

        {# Since 2.19.0 (Beacon spec 234, FR-028): the custom field filter (field, operator, value), sent as GET. #}
        {% if customFieldFilter|default(null) is not null %}
            {{ form_start(customFieldFilter, {attr: {class: 'nowo-ui-filter-bar nowo-task-list__custom-filter', 'data-testid': 'nowo-task-custom-field-filter'}}) }}
                {{ form_widget(customFieldFilter) }}
                <button type="submit" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}">{{ 'task_board.custom_field.filter.apply'|trans({}, 'NowoTaskBoardBundle') }}</button>
            {{ form_end(customFieldFilter) }}
        {% endif %}

        {% set _groups = board.columns|map(c => {column: c, tasks: tasks|filter(t => t.column and t.column.id == c.id)}) %}
        {% set _orphans = tasks|filter(t => not t.column) %}
        {% if _orphans is not empty %}
            {% set _groups = _groups|merge([{column: null, tasks: _orphans}]) %}
        {% endif %}
        {% for group in _groups %}
            {% set _color = group.column ? group.column.color|nowo_task_board_safe_color : null %}
            {#
                Since 1.13 the groups fold with UiKit's collapse-panel peer (state per board and column in localStorage,
                the disclosure chevron of the host's icon set); without the peer registered they stay open.
            #}
            <section class="nowo-task-list__group{{ _color ? ' nowo-task-list__group--colored' : '' }}"
                data-controller="collapse-panel"
                data-collapse-panel-id-value="{{ board.id }}-{{ group.column ? group.column.id : 'none' }}"
                data-collapse-panel-storage-key-value="nowo-task-board.list-groups"
                {% if _color %}data-nowo-task-vars="{{ {'--nowo-task-column-color': _color}|json_encode }}"{% endif %}>
                <button type="button" class="nowo-task-list__group-header" data-collapse-panel-target="button" data-action="collapse-panel#toggle" data-controller="disclosure-icon" aria-expanded="true">
                    {% set _set = nowo_ui_kit_icon_set|default('tabler-icons') %}
                    {{ include('@NowoUiKitBundle/partials/_disclosure_icon.html.twig', {
                        class: 'nowo-task-list__group-caret',
                        morph: true,
                        icons: _set == 'ux_icon' ? {open: 'tabler:chevron-down', closed: 'tabler:chevron-right'} : {},
                    }, false, true) }}
                    <span class="nowo-task-list__group-name">
                        {% if group.column %}
                            {{ include('@NowoTaskBoardBundle/manage/_column_icon.html.twig', {icon: group.column.icon}) }}{{ group.column.name }}
                        {% else %}
                            {{ 'task_board.task.no_column'|trans({}, 'NowoTaskBoardBundle') }}
                        {% endif %}
                    </span>
                    <span class="nowo-task-list__group-count">{{ group.tasks|length }}</span>
                </button>
                <div class="nowo-task-list__group-body" data-collapse-panel-target="body">
                {% if group.tasks is empty %}
                    <p class="nowo-task-list__empty">{{ 'task_board.board.column_empty'|trans({}, 'NowoTaskBoardBundle') }}</p>
                {% else %}
                    {% embed nowo_ui_partial('table', 'NowoTaskBoardBundle') with {
                        table: nowo_task_board_list_table(group.tasks, panelTargetPath|default(null), customFields|default([])),
                        label: group.column ? group.column.name : 'task_board.task.no_column'|trans({}, 'NowoTaskBoardBundle'),
                        foot_attr: {class: 'nowo-task-list__time-col', 'data-nowo-task-board-list-filter-target': 'totals'},
                        bundle: 'NowoTaskBoardBundle',
                    } %}
                        {% block nowo_ui_table_row %}
                            {{ include('@NowoTaskBoardBundle/manage/_list_row_cells.html.twig', {task: row, customFields: customFields|default([]), customValues: customValues|default({})}) }}
                        {% endblock %}
                        {# Since 1.15: the totals of the rows the filters show (kept up to date by the list filter controller). #}
                        {% block nowo_ui_table_foot %}
                            <tr>
                                <th scope="row" colspan="{{ (nowo_task_board_numbers_enabled() ? 6 : 5) + customFields|default([])|length }}">{{ 'task_board.list.total_shown'|trans({}, 'NowoTaskBoardBundle') }}</th>
                                <td class="nowo-task-list__num" data-total="estimate">—</td>
                                <td class="nowo-task-list__num" data-total="spent">—</td>
                                <td class="nowo-task-list__num" data-total="deviation">—</td>
                            </tr>
                        {% endblock %}
                    {% endembed %}
                {% endif %}
                {% if group.column and (canEditBoard ?? false) and inlineTaskForms[group.column.id] is defined %}
                    {{ include('@NowoTaskBoardBundle/manage/_inline_task_add.html.twig', {form: inlineTaskForms[group.column.id]}) }}
                {% endif %}
                </div>
            </section>
        {% else %}
            <p class="nowo-task-list__empty">{{ 'task_board.list.empty'|trans({}, 'NowoTaskBoardBundle') }}</p>
        {% endfor %}

        {% if tasks is not empty %}
            <dl class="nowo-task-list__totals nowo-task-list__time-col" data-nowo-task-board-list-filter-target="totals" aria-label="{{ 'task_board.list.total_shown'|trans({}, 'NowoTaskBoardBundle') }}">
                <div><dt>{{ 'task_board.list.total_shown'|trans({}, 'NowoTaskBoardBundle') }} · {{ 'task_board.time.estimate'|trans({}, 'NowoTaskBoardBundle') }}</dt><dd data-total="estimate">—</dd></div>
                <div><dt>{{ 'task_board.time.spent'|trans({}, 'NowoTaskBoardBundle') }}</dt><dd data-total="spent">—</dd></div>
                <div><dt>{{ 'task_board.time.deviation'|trans({}, 'NowoTaskBoardBundle') }}</dt><dd data-total="deviation">—</dd></div>
            </dl>
        {% endif %}
    </div>
    {% endblock %}

    {# Since 1.23: the archived tasks of the board (a provider sync archives the tasks the provider deleted). #}
    {% block nowo_task_board_archived %}
        {% if archivedTasks|default([]) is not empty %}
            <details class="nowo-task-section nowo-task-list__archived nowo-task-mt-4" data-testid="nowo-task-archived">
                <summary class="nowo-task-section__title">{{ 'task_board.list.archived'|trans({'%count%': archivedTasks|length}, 'NowoTaskBoardBundle') }}</summary>
                <ul class="nowo-task-plain-list nowo-task-mt-2">
                    {% for task in archivedTasks %}
                        <li class="nowo-task-flex nowo-task-wrap nowo-task-center nowo-task-gap nowo-task-mb-2">
                            <a href="{{ path(nowo_task_board_route('task'), {taskId: task.id}) }}">{{ task.title }}</a>
                            <span class="{{ nowo_ui_class('badge_neutral', 'NowoTaskBoardBundle') }}">{{ ('task_board.task.archive_reason.' ~ (task.archiveReason ?? 'user'))|trans({}, 'NowoTaskBoardBundle') }}</span>
                            {% if restoreForms[task.id] is defined %}
                                {{ form_start(restoreForms[task.id], {action: path(nowo_task_board_route('task_restore'), {taskId: task.id}), method: 'POST', attr: {class: 'd-inline'}}) }}
                                    <button type="submit" class="{{ nowo_ui_class('btn_sm', 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}">{{ 'task_board.task.restore'|trans({}, 'NowoTaskBoardBundle') }}<span class="visually-hidden"> {{ task.title }}</span></button>
                                {{ form_end(restoreForms[task.id]) }}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </details>
        {% endif %}
    {% endblock %}
{% endblock %}
