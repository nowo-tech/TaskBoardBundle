{#
    Since 1.23: the provider connection in the board header (board, list and Gantt views). sync = the result of
    nowo_task_board_connection(board): null shows nothing. Override with templates.connection_badge.
    Since 1.25.2: sync.badge.connect_link false = an unlinked board shows nothing (no Connect link, no empty strip).
    Since 1.26.3: sync.activeRunId, sync.progressUrl (managers only), sync.total, sync.processed, sync.pollInterval;
    with sync.badge.progress (sync.progress) the running run shows a <progress> driven by the
    nowo-task-board-sync-progress controller (polite live region, at most one update every 5 s, *Show result* at the end).
    Since 2.5.0 (TB-16): sync.badge.style strip draws `_connection_strip.html.twig` instead (a UiKit notice strip).
#}
{% if sync and (sync.linked or (nowo_task_board_sync_badge_connect_link ?? true)) and (nowo_task_board_sync_badge_style ?? 'badge') == 'strip' %}
    {{ include('@NowoTaskBoardBundle/manage/_connection_strip.html.twig', {sync: sync, board: board}, with_context: false) }}
{% elseif sync and (sync.linked or (nowo_task_board_sync_badge_connect_link ?? true)) %}
    <div class="nowo-task-sync-badge nowo-task-flex nowo-task-wrap nowo-task-center nowo-task-gap nowo-task-mb-3" data-testid="nowo-task-sync-badge">
        {% if sync.linked %}
            <span class="{{ nowo_ui_class('badge_info', 'NowoTaskBoardBundle') }} nowo-task-sync-badge__label">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'plug-connected'}) }}{{ sync.providerLabelKey|trans({}, 'NowoTaskBoardBundle') }} · {{ sync.containerLabel }}
            </span>
            {% if sync.running and (sync.progress ?? false) and (sync.progressUrl ?? null) %}
                <span class="nowo-task-sync-badge__progress nowo-task-flex nowo-task-wrap nowo-task-center nowo-task-gap"
                    data-controller="nowo-task-board-sync-progress"
                    data-nowo-task-board-sync-progress-url-value="{{ sync.progressUrl }}"
                    data-nowo-task-board-sync-progress-interval-value="{{ sync.pollInterval ?? 2000 }}"
                    data-testid="nowo-task-sync-badge-progress">
                    {% if sync.total %}
                        <progress class="nowo-task-sync__bar" max="{{ sync.total }}" value="{{ min(sync.processed, sync.total) }}" aria-label="{{ 'task_board.sync.status.running_now'|trans({}, 'NowoTaskBoardBundle') }}" data-nowo-task-board-sync-progress-target="bar"></progress>
                    {% else %}
                        <progress class="nowo-task-sync__bar" aria-label="{{ 'task_board.sync.status.running_now'|trans({}, 'NowoTaskBoardBundle') }}" data-nowo-task-board-sync-progress-target="bar"></progress>
                    {% endif %}
                    <span class="{{ nowo_ui_class('muted', 'NowoTaskBoardBundle') }} nowo-task-small" role="status" aria-live="polite" aria-atomic="true" data-nowo-task-board-sync-progress-target="status">{{ 'task_board.sync.status.running_now'|trans({}, 'NowoTaskBoardBundle') }}</span>
                    <a class="nowo-task-small" href="{{ path(nowo_task_board_route('board_connection'), {boardId: board.id}) }}" hidden data-nowo-task-board-sync-progress-target="done">{{ 'task_board.sync.progress.show_result'|trans({}, 'NowoTaskBoardBundle') }}</a>
                </span>
            {% else %}
            <span class="{{ nowo_ui_class('muted', 'NowoTaskBoardBundle') }} nowo-task-small">
                {% if sync.running %}
                    {{ 'task_board.sync.status.running_now'|trans({}, 'NowoTaskBoardBundle') }}
                {% elseif sync.lastSuccessAt %}
                    {{ 'task_board.sync.status.last_sync'|trans({'%date%': sync.lastSuccessAt|date('Y-m-d H:i')}, 'NowoTaskBoardBundle') }}
                {% else %}
                    {{ 'task_board.sync.status.never'|trans({}, 'NowoTaskBoardBundle') }}
                {% endif %}
            </span>
            {% endif %}
            {% if sync.canManage %}
                {{ form_start(sync.refreshForm, {action: path(nowo_task_board_route('board_connection_refresh'), {boardId: board.id}), method: 'POST', attr: {class: 'd-inline'}}) }}
                    <button type="submit" class="{{ nowo_ui_class('btn_sm', 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-testid="nowo-task-sync-header-refresh"{% if sync.running %} disabled aria-disabled="true"{% endif %}>
                        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'refresh'}) }}{{ 'task_board.sync.refresh.action'|trans({'%provider%': sync.providerLabelKey|trans({}, 'NowoTaskBoardBundle')}, 'NowoTaskBoardBundle') }}
                    </button>
                {{ form_end(sync.refreshForm) }}
                <a class="{{ nowo_ui_class('btn_sm', 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" href="{{ path(nowo_task_board_route('board_connection'), {boardId: board.id}) }}">{{ 'task_board.sync.page.link'|trans({}, 'NowoTaskBoardBundle') }}</a>
            {% endif %}
        {% elseif sync.canManage %}
            <a class="{{ nowo_ui_class('btn_sm', 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" href="{{ path(nowo_task_board_route('board_connection'), {boardId: board.id}) }}" data-testid="nowo-task-sync-connect-link">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'plug'}) }}{{ 'task_board.sync.connect.action'|trans({}, 'NowoTaskBoardBundle') }}
            </a>
        {% endif %}
    </div>
{% endif %}
