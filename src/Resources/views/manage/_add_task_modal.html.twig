{#
    Add task dialog on the board. Since 1.14 a native <dialog> styled by task-board.css (no CSS framework modal):
    title, priority and column, description, estimate and due date, tags and the task colour. Since 1.26 (dialog
    rule v2) Cancel and Add task sit in the footer, outside the scrolling form (form="nowo-task-board-add-task-form").
#}
{% set _body %}
    {{ form_start(taskForm, {
        action: path(nowo_task_board_route('task_create'), {boardId: board.id}),
        method: 'POST',
        attr: {id: 'nowo-task-board-add-task-form', class: 'nowo-task-dialog__body'},
    }) }}
        <div class="nowo-task-field">{{ form_row(taskForm.title, {attr: {'data-nowo-task-board-add-task-modal-target': 'titleInput', maxlength: 255}}) }}</div>
        <div class="nowo-task-dialog__grid">
            <div class="nowo-task-field">{{ form_row(taskForm.priority) }}</div>
            {# A board without columns has no column field (TaskFormType adds it only with choices). #}
            {% if taskForm.columnId is defined %}
                <div class="nowo-task-field">{{ form_row(taskForm.columnId, {attr: {'data-nowo-task-board-add-task-modal-target': 'columnField'}}) }}</div>
            {% endif %}
        </div>
        <div class="nowo-task-field">{{ form_row(taskForm.description) }}</div>
        <div class="nowo-task-dialog__grid">
            <div class="nowo-task-field">{{ form_row(taskForm.estimatedMinutes) }}</div>
            {# Since 1.15: the start date beside the due date. #}
            {% if taskForm.startAt is defined %}
                <div class="nowo-task-field">{{ form_row(taskForm.startAt) }}</div>
            {% endif %}
            <div class="nowo-task-field">{{ form_row(taskForm.dueAt) }}</div>
        </div>
        <div class="nowo-task-field">{{ form_row(taskForm.tags) }}</div>
        {% if taskForm.color is defined %}
            {{ include('@NowoTaskBoardBundle/manage/_colour_picker.html.twig', {
                field: taskForm.color,
                custom: taskForm.customColor,
                groupLabel: 'task_board.form.task.color'|trans({}, 'NowoTaskBoardBundle'),
            }) }}
        {% endif %}
        {% for child in taskForm %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(taskForm) }}
{% endset %}
{% set _footer %}
        <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-nowo-ui-dialog-close>
            {{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}
        </button>
        <button type="submit" form="nowo-task-board-add-task-form" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}">
            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'plus'}) }}{{ 'task_board.action.add_task'|trans({}, 'NowoTaskBoardBundle') }}
        </button>
{% endset %}
{{ include(nowo_ui_partial('dialog', 'NowoTaskBoardBundle'), {
    id: 'nowo-task-board-add-task-modal',
    title: 'task_board.board.add_task'|trans({}, 'NowoTaskBoardBundle'),
    bundle: 'NowoTaskBoardBundle',
    root_class: 'nowo-task-dialog nowo-task-dialog--native nowo-task-dialog--wide',
    size: 'wide',
    attr: {'data-nowo-task-board-add-task-modal-target': 'modal'},
    title_attr: {'data-nowo-task-board-add-task-modal-target': 'title'},
    body: _body,
    footer: _footer,
    footer_attr: {class: 'nowo-task-dialog__footer nowo-task-dialog__actions'},
}, false) }}
