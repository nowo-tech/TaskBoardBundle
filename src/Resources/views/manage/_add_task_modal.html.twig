{#
    Add task dialog of the board and the calendar. Since 3.6.0 (owner rule 2026-11-23, every dialog loads its content on
    demand) the content of the GET of `task_new`, answered as a fragment for UiKit's remote dialog (`X-Nowo-Dialog: 1`); the
    page holds one empty shell and the openers (links). Title, priority and column, description, estimate and due date,
    tags and the task colour; Cancel and Add task sit in the footer, outside the scrolling form
    (form="nowo-task-board-add-task-form"). Variables: board, taskForm, addTaskQuery (calendar, _target_path),
    taskTemplatePicker (optional).
#}
{% set _body %}
    {# Since 2.16.0 (FR-061): the Template picker, a GET form of its own (before the task form, never inside it). #}
    {% if taskTemplatePicker|default(null) %}
        {{ form_start(taskTemplatePicker, {attr: {class: 'nowo-task-dialog__body nowo-task-template-picker', 'data-testid': 'nowo-task-template-form'}}) }}
            <div class="nowo-task-field">{{ form_row(taskTemplatePicker.taskTemplate) }}</div>
            {{ form_rest(taskTemplatePicker) }}
            <noscript><button type="submit" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}">{{ 'task_board.template.apply'|trans({}, 'NowoTaskBoardBundle') }}</button></noscript>
        {{ form_end(taskTemplatePicker) }}
    {% endif %}
    {{ form_start(taskForm, {
        action: path(nowo_task_board_route('task_create'), {boardId: board.id}|merge(addTaskQuery|default({}))),
        method: 'POST',
        attr: {id: 'nowo-task-board-add-task-form', class: 'nowo-task-dialog__body'},
    }) }}
        <div class="nowo-task-field">{{ form_row(taskForm.title, {attr: {'data-nowo-task-board-add-task-modal-target': 'titleInput', maxlength: 255, autofocus: 'autofocus'}}) }}</div>
        <div class="nowo-task-dialog__grid">
            <div class="nowo-task-field">{{ form_row(taskForm.priority) }}</div>
            {# A board without columns has no column field (TaskFormType adds it only with choices). #}
            {% if taskForm.columnId is defined %}
                <div class="nowo-task-field">{{ form_row(taskForm.columnId, {attr: {}}) }}</div>
            {% endif %}
        </div>
        <div class="nowo-task-field">{{ form_row(taskForm.description) }}</div>
        <div class="nowo-task-dialog__grid">
            <div class="nowo-task-field">{{ form_row(taskForm.estimatedMinutes) }}</div>
            {# Since 1.15: the start date beside the due date. #}
            {% if taskForm.startAt is defined %}
                <div class="nowo-task-field">{{ form_row(taskForm.startAt) }}</div>
            {% endif %}
            <div class="nowo-task-field">{{ form_row(taskForm.dueAt) }}</div>
        </div>
        <div class="nowo-task-field">{{ form_row(taskForm.tags) }}</div>
        {% if taskForm.color is defined %}
            {{ include('@NowoTaskBoardBundle/manage/_colour_picker.html.twig', {
                field: taskForm.color,
                custom: taskForm.customColor,
                groupLabel: 'task_board.form.task.color'|trans({}, 'NowoTaskBoardBundle'),
            }) }}
        {% endif %}
        {% for child in taskForm %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(taskForm) }}
{% endset %}
{% set _footer %}
        <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-nowo-ui-dialog-close>
            {{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}
        </button>
        <button type="submit" form="nowo-task-board-add-task-form" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}">
            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'plus'}) }}{{ 'task_board.action.add_task'|trans({}, 'NowoTaskBoardBundle') }}
        </button>
{% endset %}
<div data-controller="nowo-task-board-add-task-modal" data-nowo-task-board-add-task-modal-fragment-value="true">
    {{ _body }}
</div>
<div class="nowo-task-dialog__footer nowo-task-dialog__actions" data-nowo-ui-dialog-actions>{{ _footer }}</div>
