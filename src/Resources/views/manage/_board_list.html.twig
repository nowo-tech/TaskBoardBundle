{#
    Since 1.24: a list of boards (e.g. a host's board switcher dialog), each one through _board_list_item.html.twig.
    Variables: boards.
#}
{% set _tenantLabels = nowo_task_board_tenant_labels(boards) %}
<ul class="nowo-task-board-list nowo-task-plain-list nowo-task-mb-0" role="list" data-testid="nowo-task-board-list">
    {% for board in boards %}
        {{ include('@NowoTaskBoardBundle/manage/_board_list_item.html.twig', {board: board, tenantLabels: _tenantLabels}) }}
    {% endfor %}
</ul>
