{# Since 1.23: Unlink behind a confirm dialog (the tasks stay). unlinkForm, board, connection. #}
<div>
    <button type="button" class="{{ nowo_ui_class('btn_danger', 'NowoTaskBoardBundle') }}" data-nowo-ui-dialog-open="nowo-task-sync-unlink" data-testid="nowo-task-sync-unlink">
        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'unlink'}) }}{{ 'task_board.sync.unlink.action'|trans({}, 'NowoTaskBoardBundle') }}
    </button>
    {% set _body %}
        {# Since 1.26 (dialog rule v2): the actions in the footer, outside the body (form="nowo-task-sync-unlink-form"). #}
        {{ form_start(unlinkForm, {action: path(nowo_task_board_route('board_connection_unlink'), {boardId: board.id}), method: 'POST', attr: {id: 'nowo-task-sync-unlink-form', class: 'nowo-task-dialog__body'}}) }}
            <p>{{ 'task_board.sync.unlink.text'|trans({'%list%': connection.containerLabel}, 'NowoTaskBoardBundle') }}</p>
        {{ form_end(unlinkForm) }}
    {% endset %}
    {% set _footer %}
            <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-nowo-ui-dialog-close>{{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}</button>
            <button type="submit" form="nowo-task-sync-unlink-form" class="{{ nowo_ui_class('btn_danger_solid', 'NowoTaskBoardBundle') }}" data-testid="nowo-task-sync-unlink-confirm">{{ 'task_board.sync.unlink.confirm'|trans({}, 'NowoTaskBoardBundle') }}</button>
    {% endset %}
    {{ include(nowo_ui_partial('dialog', 'NowoTaskBoardBundle'), {
        id: 'nowo-task-sync-unlink',
        title: 'task_board.sync.unlink.title'|trans({}, 'NowoTaskBoardBundle'),
        bundle: 'NowoTaskBoardBundle',
        root_class: 'nowo-task-dialog nowo-task-dialog--native',
        attr: {'data-dialog': 'unlink'},
        body: _body,
        footer: _footer,
        footer_attr: {class: 'nowo-task-dialog__footer nowo-task-dialog__actions'},
    }, false) }}
</div>
