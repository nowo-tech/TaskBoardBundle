{#
    Since 2.5.0 (TB-15): the footer of a New board dialog — Back (the scope step only), Cancel and Create — for the form of
    `_board_create_form.html.twig` rendered with with_actions: false. The index dialog uses it; a host page reuses it
    next to the form (e.g. a dashboard outside any tenant).
    Variables: form (the TaskBoardFormType view), form_id (default nowo-task-board-create-form), testid (of Create,
    default nowo-task-board-create-submit), bundle (UiKit theme bundle, default NowoTaskBoardBundle), no_cancel (default
    false: the surrounding dialog has its own close), close_attribute (default data-nowo-ui-dialog-close: the attribute
    that makes Cancel close the host's dialog; a `data-*` name only).
    Since 2.7.0 (TB-15b): back_testid (default `<step_testid_prefix>-back`, the prefix defaulting to
    nowo-task-board-create like the form's), back_icon (default arrow-left), cancel_icon
    (default x) and create_icon (default plus): a Tabler name of the bundle's `_icon.html.twig`, or false for none.
#}
{% set _form_id = form_id|default(null) ?: 'nowo-task-board-create-form' %}
{% set _bundle = bundle|default(null) ?: 'NowoTaskBoardBundle' %}
{% set _back_testid = back_testid|default(null) ?: (step_testid_prefix|default(null) ?: 'nowo-task-board-create') ~ '-back' %}
{% set _back_icon = back_icon ?? 'arrow-left' %}
{% set _cancel_icon = cancel_icon ?? 'x' %}
{% set _create_icon = create_icon ?? 'plus' %}
{% set _close = close_attribute|default('') matches '/^data-[a-z0-9][a-z0-9-]*$/D' ? close_attribute : 'data-nowo-ui-dialog-close' %}
{% if form.scope is defined %}
    <button type="button" class="{{ nowo_ui_class('btn_secondary', _bundle) }}" data-nowo-ui-dialog-back data-nowo-task-board-create-form="{{ _form_id }}" data-testid="{{ _back_testid }}" hidden>{% if _back_icon %}{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: _back_icon}) }}{% endif %}{{ 'task_board.action.back'|trans({}, 'NowoTaskBoardBundle') }}</button>
{% endif %}
{% if not no_cancel|default(false) %}
    <button type="button" class="{{ nowo_ui_class('btn_secondary', _bundle) }}" {{ _close }}>{% if _cancel_icon %}{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: _cancel_icon}) }}{% endif %}{{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}</button>
{% endif %}
<button type="submit" form="{{ _form_id }}" class="{{ nowo_ui_class('btn_primary', _bundle) }}" data-testid="{{ testid|default(null) ?: 'nowo-task-board-create-submit' }}">
    {% if _create_icon %}{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: _create_icon}) }}{% endif %}{{ 'task_board.action.create'|trans({}, 'NowoTaskBoardBundle') }}
</button>
