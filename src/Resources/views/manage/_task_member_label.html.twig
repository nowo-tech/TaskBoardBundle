{% macro member_label(user, badges = false) %}
    {#- Since 2.15.0: the host user behind a user reference (database.user_reference: id); the user as it is otherwise. -#}
    {%- set user = nowo_task_board_user(user) -%}
    {% if user.displayName is defined and user.displayName %}
        {{ user.displayName }}
    {% elseif user.fullName is defined and user.fullName %}
        {{ user.fullName }}
    {% elseif user.email is defined and user.email %}
        {{ user.email }}
    {% elseif user.username is defined and user.username %}
        {{ user.username }}
    {% elseif user.id is defined %}
        #{{ user.id }}
    {% else %}
        {{ 'task_board.task.unknown_member'|trans({}, 'NowoTaskBoardBundle') }}
    {% endif %}
    {#- Since 2.18.0 (Beacon spec 234): with badges = true, the host's member badges (member_badge_provider) after the name,
        through the member_label_suffix block of _member_label_suffix.html.twig. Without badges the output is unchanged. -#}
    {%- if badges -%}{%- set _badges = nowo_task_board_member_badges(user) -%}{%- if _badges is not empty -%}{{ include('@NowoTaskBoardBundle/manage/_member_label_suffix.html.twig', {badges: _badges}, with_context: false) }}{%- endif -%}{%- endif %}
{% endmacro %}
