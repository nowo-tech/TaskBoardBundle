{# Since 2.0.0: the Board / List / Gantt links of a board, shared by _board_list_item and _board_row. board. #}
<div class="nowo-task-board-list__views" role="group" aria-label="{{ 'task_board.index.views_of'|trans({'%name%': board.name}, 'NowoTaskBoardBundle') }}">
    {% for view in [
        {route: 'board', params: {view: 'board'}, icon: 'layout-kanban', label: 'task_board.view.board', aria: 'task_board.index.open_board', slot: 'btn_primary'},
        {route: 'list', params: {}, icon: 'list', label: 'task_board.view.list', aria: 'task_board.index.open_list', slot: 'btn_secondary'},
        {route: 'gantt', params: {}, icon: 'chart-bar', label: 'task_board.view.gantt', aria: 'task_board.index.open_gantt', slot: 'btn_secondary'},
    ] %}
        <a href="{{ path(nowo_task_board_route(view.route), {boardId: board.id}|merge(view.params)) }}" class="{{ nowo_ui_class(view.slot, 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_sm', 'NowoTaskBoardBundle') }}" aria-label="{{ view.aria|trans({'%name%': board.name}, 'NowoTaskBoardBundle') }}" data-testid="nowo-task-board-view-{{ view.route }}">
            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: view.icon}) }}{{ view.label|trans({}, 'NowoTaskBoardBundle') }}
        </a>
    {% endfor %}
</div>
