{% if tags is not empty %}
    <div class="nowo-task-tags{% if wrapper_class|default('') %} {{ wrapper_class }}{% endif %}">
        {% for tag in tags %}
            <span class="{{ nowo_ui_class('badge_neutral', 'NowoTaskBoardBundle') }} nowo-task-tag">{{ tag }}</span>
        {% endfor %}
    </div>
{% endif %}
