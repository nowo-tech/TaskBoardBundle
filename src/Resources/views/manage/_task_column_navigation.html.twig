<div class="{{ nowo_ui_class('card', 'NowoTaskBoardBundle') }} nowo-task-mb-4">
    <div class="{{ nowo_ui_class('card_header', 'NowoTaskBoardBundle') }}">
        <h2 class="{{ nowo_ui_class('card_title', 'NowoTaskBoardBundle') }}">{{ 'task_board.task.workflow'|trans({}, 'NowoTaskBoardBundle') }}</h2>
    </div>
    <div class="{{ nowo_ui_class('card_body', 'NowoTaskBoardBundle') }}">
        <div class="nowo-task-flex nowo-task-center nowo-task-gap nowo-task-wrap nowo-task-mb-3">
            <span class="{{ nowo_ui_class('muted', 'NowoTaskBoardBundle') }}">{{ 'task_board.task.current_column'|trans({}, 'NowoTaskBoardBundle') }}:</span>
            {% if columnNavigation.currentColumnName %}
                <span class="{{ nowo_ui_class('badge_info', 'NowoTaskBoardBundle') }}">{{ columnNavigation.currentColumnName }}</span>
            {% else %}
                <span class="{{ nowo_ui_class('muted', 'NowoTaskBoardBundle') }}">—</span>
            {% endif %}
            {% if columnNavigation.isCompleted %}
                <span class="{{ nowo_ui_class('badge_success', 'NowoTaskBoardBundle') }}">{{ 'task_board.task.completed_badge'|trans({}, 'NowoTaskBoardBundle') }}</span>
            {% endif %}
        </div>

        <div class="nowo-task-detail__status-actions">
            <button
                type="submit"
                form="nowo-task-advance-form"
                formmethod="post"
                formaction="{{ path(nowo_task_board_route('task_advance'), {taskId: task.id}|merge(taskRouteExtra|default({}))) }}"
                name="action"
                value="previous"
                class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}"
                {% if not columnNavigation.canPrevious %} disabled{% endif %}
            >
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'arrow-left'}) }}
                {% if columnNavigation.previousColumnName %}
                    {{ 'task_board.action.previous_column_to'|trans({'%column%': columnNavigation.previousColumnName}, 'NowoTaskBoardBundle') }}
                {% else %}
                    {{ 'task_board.action.previous_column'|trans({}, 'NowoTaskBoardBundle') }}
                {% endif %}
            </button>

            <button
                type="submit"
                form="nowo-task-advance-form"
                formmethod="post"
                formaction="{{ path(nowo_task_board_route('task_advance'), {taskId: task.id}|merge(taskRouteExtra|default({}))) }}"
                name="action"
                value="next"
                class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}"
                {% if not columnNavigation.canNext %} disabled{% endif %}
            >
                {% if columnNavigation.nextColumnName %}
                    {{ 'task_board.action.next_column_to'|trans({'%column%': columnNavigation.nextColumnName}, 'NowoTaskBoardBundle') }}
                {% else %}
                    {{ 'task_board.action.next_column'|trans({}, 'NowoTaskBoardBundle') }}
                {% endif %}
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'arrow-right'}) }}
            </button>

            <button
                type="submit"
                form="nowo-task-advance-form"
                formmethod="post"
                formaction="{{ path(nowo_task_board_route('task_advance'), {taskId: task.id}|merge(taskRouteExtra|default({}))) }}"
                name="action"
                value="done"
                class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}"
                {% if not columnNavigation.canDone %} disabled{% endif %}
            >
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'circle-check'}) }}
                {% if columnNavigation.doneColumnName %}
                    {{ 'task_board.action.mark_done_column'|trans({'%column%': columnNavigation.doneColumnName}, 'NowoTaskBoardBundle') }}
                {% else %}
                    {{ 'task_board.action.mark_done'|trans({}, 'NowoTaskBoardBundle') }}
                {% endif %}
            </button>
        </div>
    </div>
</div>
