{#
    Kanban card of a task (since 1.10 a partial). Variables: task; taskTree (optional, for the subtask counter).
#}
{% set progress = taskTree|default(null) ? taskTree.progress(task) : null %}
{% set priorityColor = task.priority.value == 'urgent' ? 'red' : (task.priority.value == 'high' ? 'orange' : (task.priority.value == 'low' ? 'secondary' : 'blue')) %}
<li
    class="nowo-task-board__task nowo-task-card{{ task.completed ? ' is-done' : '' }}"
    draggable="true"
    data-nowo-task-board-target="task"
    data-task-id="{{ task.id }}"
    data-move-url="{{ path(nowo_task_board_route('task_move'), {taskId: task.id}) }}"
>
    <a href="{{ path(nowo_task_board_route('task'), {taskId: task.id}) }}" class="nowo-task-board__task-title nowo-task-card__title d-block mb-1">{{ task.title }}</a>
    <div class="nowo-task-card__meta d-flex align-items-center gap-2 flex-wrap">
        <span class="nowo-task-card__priority badge bg-{{ priorityColor }}-lt text-{{ priorityColor }}">
            {{ task.priority.value }}
        </span>
        {% if task.estimatedMinutes %}
            <span class="nowo-task-card__estimate text-secondary small"><i class="ti ti-clock"></i> {{ task.estimatedMinutes }}m</span>
        {% endif %}
        {% if progress and progress.total > 0 %}
            <span class="nowo-task-card__subtasks text-secondary small" title="{{ 'task_board.board.subtasks_count'|trans({'%done%': progress.done, '%total%': progress.total}, 'NowoTaskBoardBundle') }}">
                <i class="ti ti-subtask" aria-hidden="true"></i> {{ progress.done }}/{{ progress.total }}
            </span>
        {% endif %}
    </div>
    {{ include('@NowoTaskBoardBundle/manage/_task_tags.html.twig', {tags: task.tags, wrapper_class: 'mt-2'}) }}
</li>
