{#
    Kanban card of a task (since 1.10 a partial). Variables: task; taskTree (optional, for the subtask counter);
    panelTargetPath (optional, since 1.11): the page the task panel's forms come back to.
    data-task-panel-url (since 1.11): the task_panel fragment for hosts that open the task in a side drawer; the title
    link keeps opening the task page without JavaScript.
    Since 1.14 a task with a colour shows it on the card's left edge (nowo-task-card--colored, --nowo-task-card-color).
    Since 1.20 the card carries data-title (the task title alone, for a drawer heading and its accessible name) and
    data-column-name (the column, for a position such as "3/14 · In progress"); the estimate reads "24 h", not "1440m".
#}
{% set progress = taskTree|default(null) ? taskTree.progress(task) : null %}
<li
    class="nowo-task-board__task nowo-task-card{{ task.completed ? ' is-done' : '' }}{{ task.color ? ' nowo-task-card--colored' : '' }}"
    {% if task.color %}data-nowo-task-vars="{{ {'--nowo-task-card-color': task.color}|json_encode }}"{% endif %}
    draggable="true"
    data-nowo-task-board-target="task"
    data-task-id="{{ task.id }}"
    data-title="{{ task.title }}"
    {% if task.column %}data-column-name="{{ task.column.name }}"{% endif %}
    data-move-url="{{ path(nowo_task_board_route('task_move'), {taskId: task.id}) }}"
    data-task-panel-url="{{ path(nowo_task_board_route('task_panel'), {taskId: task.id}|merge(panelTargetPath|default(null) ? {_target_path: panelTargetPath} : {})) }}"
>
    <a href="{{ path(nowo_task_board_route('task'), {taskId: task.id}) }}" class="nowo-task-board__task-title nowo-task-card__title">{{ task.title }}</a>
    {{ include('@NowoTaskBoardBundle/manage/_task_tags.html.twig', {tags: task.tags, wrapper_class: 'nowo-task-card__tags'}) }}
    {# Since 1.12 (ClickUp-like): priority flag, due date (late in the danger colour), estimate, subtasks and assignees. #}
    <div class="nowo-task-card__meta">
        {# The default (normal) priority is not repeated on every card. #}
        {% if task.priority.value != 'normal' %}
        <span class="nowo-task-card__priority nowo-task-priority nowo-task-priority--{{ task.priority.value }}" data-priority="{{ task.priority.value }}" title="{{ 'task_board.form.task.priority'|trans({}, 'NowoTaskBoardBundle') }}">
            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'flag'}) }}{{ ('task_board.priority.' ~ task.priority.value)|trans({}, 'NowoTaskBoardBundle') }}
        </span>
        {% endif %}
        {% if task.dueAt %}
            {% set _late = not task.completed and task.dueAt|date('Y-m-d') < 'now'|date('Y-m-d') %}
            <span class="nowo-task-card__due{{ _late ? ' is-late' : '' }}" title="{{ 'task_board.form.task.due'|trans({}, 'NowoTaskBoardBundle') }}">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'calendar'}) }}<time datetime="{{ task.dueAt|date('Y-m-d') }}">{{ task.dueAt|date('d M') }}</time>
            </span>
        {% endif %}
        {% if task.estimatedMinutes %}
            <span class="nowo-task-card__estimate">{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'clock'}) }}{{ task.estimatedMinutes|nowo_task_board_duration }}</span>
        {% endif %}
        {% if progress and progress.total > 0 %}
            <span class="nowo-task-card__subtasks" title="{{ 'task_board.board.subtasks_count'|trans({'%done%': progress.done, '%total%': progress.total}, 'NowoTaskBoardBundle') }}">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'subtask'}) }}{{ progress.done }}/{{ progress.total }}
            </span>
        {% endif %}
        {# Since 1.16: the comment count (commentCounts from the board page, one query). #}
        {% set _comments = (commentCounts|default({}))[task.id] ?? 0 %}
        {% if _comments > 0 %}
            <span class="nowo-task-card__comments" title="{{ 'task_board.comment.count_n'|trans({'%count%': _comments}, 'NowoTaskBoardBundle') }}">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'message-circle'}) }}{{ _comments }}<span class="nowo-task-sr-only"> {{ 'task_board.comment.count_n'|trans({'%count%': _comments}, 'NowoTaskBoardBundle') }}</span>
            </span>
        {% endif %}
        {% if task.members|length > 0 %}
            {% import '@NowoTaskBoardBundle/manage/_task_member_label.html.twig' as memberUi %}
            <span class="nowo-task-avatars">
                {% for member in task.members|slice(0, 3) %}
                    {% set _name = memberUi.member_label(member.user)|trim %}
                    <span class="nowo-task-avatar" title="{{ _name }}">{{ _name|slice(0, 1)|upper }}</span>
                {% endfor %}
                {% if task.members|length > 3 %}<span class="nowo-task-avatar nowo-task-avatar--more">+{{ task.members|length - 3 }}</span>{% endif %}
            </span>
        {% endif %}
    </div>
</li>
