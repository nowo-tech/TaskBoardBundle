<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            {% if breadcrumbRoute|default(null) and breadcrumbLabel|default(null) %}
                <div class="text-secondary small mb-1">
                    <a href="{{ path(breadcrumbRoute, breadcrumbParams|default({})) }}" class="text-reset">{% if breadcrumbIcon|default(null) %}<span class="nowo-task-board-icon" aria-hidden="true">{{ breadcrumbIcon }}</span> {% endif %}{{ breadcrumbLabel }}</a>
                </div>
            {% endif %}
            <h1 class="page-title">{% if pageTitleIcon|default(null) %}<span class="nowo-task-board-icon" aria-hidden="true">{{ pageTitleIcon }}</span> {% endif %}{{ pageTitle }}</h1>
            {#- Since 1.30.0 (spec 211): a Markdown description replaces the plain subtitle. -#}
            {% if pageDescriptionBoard|default(null) and pageDescriptionBoard.description and pageDescriptionBoard.descriptionFormat == 'markdown' %}
                {{ include('@NowoTaskBoardBundle/manage/_board_description.html.twig', {board: pageDescriptionBoard}) }}
            {% elseif pageSubtitle|default(null) %}
                <p class="text-secondary mb-0">{{ pageSubtitle }}</p>
            {% endif %}
        </div>
        <div class="col-auto d-flex gap-2 flex-wrap">
            {# Since 1.10: a list of {href, label, icon?, class?} rendered with auto-escaping (no |raw). #}
            {% if headerActions is defined and headerActions is iterable %}
                {% for action in headerActions %}
                    <a href="{{ action.href }}" class="btn {{ action.class|default('btn-outline-primary') }}">
                        {%- if action.icon|default(null) %}{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: (action.icon)}) }} {% endif -%}
                        {{ action.label }}
                    </a>
                {% endfor %}
            {% elseif headerActions is defined %}
                {# A string from an older override is printed escaped. #}
                {{ headerActions }}
            {% endif %}
            {% if dashboardRoute|default(null) %}
                <a href="{{ path(dashboardRoute) }}" class="btn btn-outline-secondary">{{ 'task_board.action.back'|trans({}, 'NowoTaskBoardBundle') }}</a>
            {% endif %}
        </div>
    </div>
</div>
