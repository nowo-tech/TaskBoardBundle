{#
    Since 1.18: "Import subtasks" on a task — a file of tasks becomes this task's subtask tree with its Gantt relations;
    the help modal documents the format. Editors only (subtaskImportForm is null otherwise).
    Variables: task, subtaskImportForm; since 1.22.1 optional help_link ({url, label}, default: the Twig global
    nowo_task_board_import_help_link) rendered as an escaped link under the source select, and the empty block
    import_help at the same place (for a template that embeds this one). Since 1.24 help_link.anchor_from: 'source'
    makes the link's #anchor follow the selected source. Since 1.26 (dialog rule v2) the footer sits outside the
    scrolling form: Help (secondary) on the left, Cancel and Import (form="nowo-task-subtask-import-form-<task id>").
#}
{% if subtaskImportForm|default(null) %}
    <div class="nowo-task-subtask-import">
        <button type="button" class="{{ nowo_ui_class('btn_sm', 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }} nowo-task-subtask-import__open" data-nowo-ui-dialog-open="nowo-task-subtask-import-{{ task.id }}">
            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'upload'}) }}{{ 'task_board.import.subtasks.action'|trans({}, 'NowoTaskBoardBundle') }}
        </button>
        {% set _body %}
            {{ form_start(subtaskImportForm, {method: 'POST', attr: {id: 'nowo-task-subtask-import-form-' ~ task.id, class: 'nowo-task-dialog__body', enctype: 'multipart/form-data'}}) }}
                <p class="nowo-task-dialog__help">{{ 'task_board.import.subtasks.help'|trans({'%title%': task.title}, 'NowoTaskBoardBundle') }}</p>
                <div class="nowo-task-field">{{ form_row(subtaskImportForm.source) }}</div>
                {# Since 1.22.1: a place for the host's help under the source select (block, or the help_link parameter). #}
                {% block import_help %}{% endblock %}
                {{ include('@NowoTaskBoardBundle/manage/_import_help_link.html.twig', {link: help_link|default(nowo_task_board_import_help_link|default(nowo_task_board_configured_help_link())), source: subtaskImportForm.source.vars.value|default('')}) }}
                {% for child in subtaskImportForm %}
                    {% if not child.rendered %}
                        <div class="nowo-task-field">{{ form_row(child) }}</div>
                    {% endif %}
                {% endfor %}
            {{ form_end(subtaskImportForm) }}
        {% endset %}
        {% set _footer %}
                <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }} nowo-task-subtask-import__help" data-nowo-ui-dialog-open="nowo-task-import-help-task-{{ task.id }}">
                    {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'help'}) }}{{ 'task_board.import.help.open'|trans({}, 'NowoTaskBoardBundle') }}
                </button>
                <div class="nowo-task-dialog__actions-end">
                    <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-nowo-ui-dialog-close>{{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}</button>
                    <button type="submit" form="nowo-task-subtask-import-form-{{ task.id }}" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}">{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'upload'}) }}{{ 'task_board.import.subtasks.submit'|trans({}, 'NowoTaskBoardBundle') }}</button>
                </div>
        {% endset %}
        {{ include(nowo_ui_partial('dialog', 'NowoTaskBoardBundle'), {
            id: 'nowo-task-subtask-import-' ~ task.id,
            title: 'task_board.import.subtasks.title'|trans({}, 'NowoTaskBoardBundle'),
            bundle: 'NowoTaskBoardBundle',
            root_class: 'nowo-task-dialog nowo-task-dialog--native',
            attr: {'data-dialog': 'subtask-import'},
            body: _body,
            footer: _footer,
            footer_attr: {class: 'nowo-task-dialog__footer nowo-task-dialog__actions nowo-task-dialog__actions--split'},
        }, false) }}
        {{ include('@NowoTaskBoardBundle/manage/_import_help.html.twig', {scope: 'task', helpId: 'task-' ~ task.id}) }}
    </div>
{% endif %}
