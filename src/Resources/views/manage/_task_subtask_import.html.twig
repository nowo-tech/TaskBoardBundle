{#
    Since 1.18: "Import subtasks" on a task — a file of tasks becomes this task's subtask tree with its Gantt relations;
    the help modal documents the format. Editors only (subtaskImportForm is null otherwise).
    Variables: task, subtaskImportForm; since 1.22.1 optional help_link ({url, label}, default: the Twig global
    nowo_task_board_import_help_link) rendered as an escaped link under the source select, and the empty block
    import_help at the same place (for a template that embeds this one). Since 1.24 help_link.anchor_from: 'source'
    makes the link's #anchor follow the selected source. Since 1.26 (dialog rule v2) the footer sits outside the
    scrolling form: Help (secondary) on the left, Cancel and Import (form="nowo-task-subtask-import-form-<task id>").
#}
{% if subtaskImportForm|default(null) %}
    <div class="nowo-task-subtask-import" data-controller="nowo-task-board-dialog">
        <button type="button" class="btn btn-sm btn-outline-secondary nowo-task-subtask-import__open" data-action="nowo-task-board-dialog#open" data-dialog="subtask-import">
            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'upload'}) }}{{ 'task_board.import.subtasks.action'|trans({}, 'NowoTaskBoardBundle') }}
        </button>
        <dialog class="nowo-task-dialog nowo-task-dialog--native" data-nowo-task-board-dialog-target="dialog" data-dialog="subtask-import" aria-labelledby="nowo-task-subtask-import-title-{{ task.id }}">
            <div class="nowo-task-dialog__header">
                <h2 class="nowo-task-dialog__title" id="nowo-task-subtask-import-title-{{ task.id }}">{{ 'task_board.import.subtasks.title'|trans({}, 'NowoTaskBoardBundle') }}</h2>
                <button type="button" class="nowo-task-dialog__close" aria-label="{{ 'task_board.action.close'|trans({}, 'NowoTaskBoardBundle') }}" data-action="nowo-task-board-dialog#close">
                    {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'x'}) }}
                </button>
            </div>
            {{ form_start(subtaskImportForm, {method: 'POST', attr: {id: 'nowo-task-subtask-import-form-' ~ task.id, class: 'nowo-task-dialog__body', enctype: 'multipart/form-data'}}) }}
                <p class="nowo-task-dialog__help">{{ 'task_board.import.subtasks.help'|trans({'%title%': task.title}, 'NowoTaskBoardBundle') }}</p>
                <div class="nowo-task-field">{{ form_row(subtaskImportForm.source) }}</div>
                {# Since 1.22.1: a place for the host's help under the source select (block, or the help_link parameter). #}
                {% block import_help %}{% endblock %}
                {{ include('@NowoTaskBoardBundle/manage/_import_help_link.html.twig', {link: help_link|default(nowo_task_board_import_help_link|default(null)), source: subtaskImportForm.source.vars.value|default('')}) }}
                {% for child in subtaskImportForm %}
                    {% if not child.rendered %}
                        <div class="nowo-task-field">{{ form_row(child) }}</div>
                    {% endif %}
                {% endfor %}
            {{ form_end(subtaskImportForm) }}
            <div class="nowo-task-dialog__footer nowo-task-dialog__actions nowo-task-dialog__actions--split">
                <button type="button" class="{{ nowo_task_board_btn_class('btn_secondary') }} nowo-task-subtask-import__help" data-action="nowo-task-board-dialog#open" data-dialog="import-help">
                    {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'help'}) }}{{ 'task_board.import.help.open'|trans({}, 'NowoTaskBoardBundle') }}
                </button>
                <div class="nowo-task-dialog__actions-end">
                    <button type="button" class="{{ nowo_task_board_btn_class('btn_secondary') }}" data-action="nowo-task-board-dialog#close">{{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}</button>
                    <button type="submit" form="nowo-task-subtask-import-form-{{ task.id }}" class="{{ nowo_task_board_btn_class('btn_primary') }}">{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'upload'}) }}{{ 'task_board.import.subtasks.submit'|trans({}, 'NowoTaskBoardBundle') }}</button>
                </div>
            </div>
        </dialog>
        {{ include('@NowoTaskBoardBundle/manage/_import_help.html.twig', {scope: 'task', helpId: 'task-' ~ task.id}) }}
    </div>
{% endif %}
