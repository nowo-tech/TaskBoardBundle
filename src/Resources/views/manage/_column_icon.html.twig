{#
    Icon of a column header (since 1.11) through UiKit components/_icon: `icon` is "<set>:<name>" (e.g. tabler:bug);
    with the ux_icon set the full name goes to ux_icon(), the webfont sets get the bare name (ti ti-bug). Decorative:
    the column name is the accessible text. Since 2.9.0 a Tabler id gets its Bootstrap Icons name with bootstrap-icons.
    Since 2.9.0 any other value (one emoji, board.column_icon_form_type) is printed as escaped text, aria-hidden too,
    whatever the icon set: it needs no icon font.
#}
{% set icon_set = nowo_ui_kit_icon_set|default('tabler-icons') %}
{% set _is_icon_id = icon|default(null) and icon matches '/^[a-z0-9-]+(:[a-z0-9-]+)?$/D' %}
{% if _is_icon_id and icon_set != 'none' %}
    <span class="nowo-task-column__icon" aria-hidden="true">
        {{- include('@NowoUiKitBundle/components/_icon.html.twig', {name: icon_set == 'ux_icon' ? icon : nowo_task_board_column_icon_name(icon, icon_set), nowo_ui_kit_icon_set: icon_set}, false) -}}
    </span>
{% elseif icon|default(null) and not _is_icon_id %}
    <span class="nowo-task-column__icon nowo-task-column__icon--emoji" aria-hidden="true">{{ icon }}</span>
{% endif %}
