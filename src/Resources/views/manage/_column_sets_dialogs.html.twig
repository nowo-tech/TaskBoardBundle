{#
    Column sets (since 1.11), for board editors: "Save columns as set" (columnSetForm) and "Add columns from set"
    (columnSetApplyForm, the list of columnSets with their delete forms in columnSetDeleteForms). Kit dialogs
    (Escape closes them, focus returns to the button). Since 1.26 (dialog rule v2) each footer sits outside the scrolling body, its primary bound with form="…"
    (nowo-task-column-set-save-form, nowo-task-column-set-apply-form); without sets, Add columns has Close only.
    Since 2.0.0 (TB-10) with board.toolbar: false the buttons go and a host's button opens the dialogs with
    data-nowo-task-board-open="column-set-save|column-set-apply".
#}
{% set columnSets = columnSets|default([]) %}
<div class="nowo-task-column-sets">
    {% if nowo_task_board_ui.board_toolbar %}
    <button type="button" class="{{ nowo_ui_class('btn_sm', 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }} nowo-task-column-sets__save" data-nowo-ui-dialog-open="nowo-task-column-set-save" data-nowo-task-board-open="column-set-save">
        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'device-floppy'}) }}{{ 'task_board.column_set.save'|trans({}, 'NowoTaskBoardBundle') }}
    </button>
    <button type="button" class="{{ nowo_ui_class('btn_sm', 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }} nowo-task-column-sets__apply" data-nowo-ui-dialog-open="nowo-task-column-set-apply" data-nowo-task-board-open="column-set-apply">
        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'columns'}) }}{{ 'task_board.column_set.apply'|trans({}, 'NowoTaskBoardBundle') }}
    </button>
    {% endif %}

    {% set _body %}
        {{ form_start(columnSetForm, {action: path(nowo_task_board_route('column_set_create'), {boardId: board.id}), method: 'POST', attr: {id: 'nowo-task-column-set-save-form', class: 'nowo-task-dialog__body'}}) }}
            <p class="nowo-task-dialog__help">{{ 'task_board.column_set.save_help'|trans({'%count%': board.columns|length}, 'NowoTaskBoardBundle') }}</p>
            {% for child in columnSetForm %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        {{ form_end(columnSetForm) }}
    {% endset %}
    {% set _footer %}
            <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-nowo-ui-dialog-close>{{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}</button>
            <button type="submit" form="nowo-task-column-set-save-form" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}">{{ 'task_board.action.save'|trans({}, 'NowoTaskBoardBundle') }}</button>
    {% endset %}
    {{ include(nowo_ui_partial('dialog', 'NowoTaskBoardBundle'), {
        id: 'nowo-task-column-set-save',
        title: 'task_board.column_set.save'|trans({}, 'NowoTaskBoardBundle'),
        bundle: 'NowoTaskBoardBundle',
        root_class: 'nowo-task-dialog nowo-task-dialog--native',
        attr: {'data-dialog': 'save'},
        body: _body,
        footer: _footer,
        footer_attr: {class: 'nowo-task-dialog__footer nowo-task-dialog__actions'},
    }, false) }}

    {% set _body %}
        <div class="nowo-task-dialog__body">
            {% if columnSets is empty %}
                <p class="nowo-task-column-sets__empty nowo-task-dialog__help">{{ 'task_board.column_set.empty'|trans({}, 'NowoTaskBoardBundle') }}</p>
            {% else %}
                {{ form_start(columnSetApplyForm, {action: path(nowo_task_board_route('column_set_apply'), {boardId: board.id}), method: 'POST', attr: {id: 'nowo-task-column-set-apply-form'}}) }}
                    <p class="nowo-task-dialog__help">{{ 'task_board.column_set.apply_help'|trans({}, 'NowoTaskBoardBundle') }}</p>
                    {% for child in columnSetApplyForm %}
                        {% if not child.rendered %}
                            {{ form_row(child) }}
                        {% endif %}
                    {% endfor %}
                {{ form_end(columnSetApplyForm) }}

                <ul class="nowo-task-column-sets__list">
                    {% for set in columnSets %}
                        <li class="nowo-task-column-sets__item" data-column-set-id="{{ set.id }}">
                            <div class="nowo-task-column-sets__info">
                                <span class="nowo-task-column-sets__name">{{ set.name }}</span>
                                <span class="nowo-task-column-sets__columns">{{ set.items|map(item => item.name)|join(', ') }}</span>
                            </div>
                            {% set deleteForm = columnSetDeleteForms[set.id] ?? null %}
                            {% if deleteForm is not null %}
                                {{ form_start(deleteForm, {attr: {
                                    class: 'nowo-task-column-sets__delete',
                                                                        'data-confirm': 'task_board.column_set.delete_confirm'|trans({'%name%': set.name}, 'NowoTaskBoardBundle'),
                                }}) }}
                                    {% for child in deleteForm %}
                                        {% if not child.rendered %}
                                            {{ form_row(child) }}
                                        {% endif %}
                                    {% endfor %}
                                    <button type="submit" class="{{ nowo_ui_class('btn_sm', 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_danger', 'NowoTaskBoardBundle') }}" aria-label="{{ 'task_board.column_set.delete_named'|trans({'%name%': set.name}, 'NowoTaskBoardBundle') }}">
                                        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'trash'}) }}
                                    </button>
                                {{ form_end(deleteForm) }}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    {% endset %}
    {% set _footer %}
            {% if columnSets is empty %}
                <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-nowo-ui-dialog-close>{{ 'task_board.action.close'|trans({}, 'NowoTaskBoardBundle') }}</button>
            {% else %}
                <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-nowo-ui-dialog-close>{{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}</button>
                <button type="submit" form="nowo-task-column-set-apply-form" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}">{{ 'task_board.column_set.apply_action'|trans({}, 'NowoTaskBoardBundle') }}</button>
            {% endif %}
    {% endset %}
    {{ include(nowo_ui_partial('dialog', 'NowoTaskBoardBundle'), {
        id: 'nowo-task-column-set-apply',
        title: 'task_board.column_set.apply'|trans({}, 'NowoTaskBoardBundle'),
        bundle: 'NowoTaskBoardBundle',
        root_class: 'nowo-task-dialog nowo-task-dialog--native',
        attr: {'data-dialog': 'apply'},
        body: _body,
        footer: _footer,
        footer_attr: {class: 'nowo-task-dialog__footer nowo-task-dialog__actions'},
    }, false) }}
</div>
