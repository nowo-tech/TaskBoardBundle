{#
    Board index (web_ui.templates.index). Since 2.0.0 on the UiKit list scaffold (TB-4). Variable: page (ListPage from
    TaskBoardManageController::indexPage(): a row per board, or the empty state; New board as the one primary, in the header when there are boards, else in the empty state).
    Also boards, boardForm, dashboardRoute, tenant, canCreateBoard, boardFormFallback (the <noscript> form) and openCreateBoard
    (the dialog opens on load: ?new=1, or an invalid submission answered 422 with its values and errors).
    Blocks: nowo_ui_list_row (one board, `row` and `loop` in context), nowo_ui_list_after, nowo_ui_modals.
#}
{% extends '@NowoUiKitBundle/page/list.html.twig' %}
{#- one provider call per list -#}
{% set _tenant_labels = nowo_task_board_tenant_labels(boards|default([])) %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/task-board.css', 'nowo_task_board') }}">
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('js/nowo-ui-open-modal.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/task-board.js', 'nowo_task_board') }}" defer></script>
{% endblock %}

{% block nowo_ui_list_row %}
    {{ include('@NowoTaskBoardBundle/manage/_board_row.html.twig', {board: row, tenantLabels: _tenant_labels}) }}
{% endblock %}

{% block nowo_ui_list_after %}
    {# Without JavaScript the dialog cannot open: the same form under the list. #}
    {% if canCreateBoard|default(false) and boardFormFallback is defined and boardFormFallback %}
        <noscript>
            <section class="{{ nowo_ui_class('card', page.bundle) }} nowo-task-mt-3" aria-labelledby="nowo-task-board-create-nojs-title">
                <div class="{{ nowo_ui_class('card_header', page.bundle) }}">
                    <h2 class="{{ nowo_ui_class('card_title', page.bundle) }}" id="nowo-task-board-create-nojs-title">{{ 'task_board.index.create_board'|trans({}, 'NowoTaskBoardBundle') }}</h2>
                </div>
                <div class="{{ nowo_ui_class('card_body', page.bundle) }}">
                    {{ include('@NowoTaskBoardBundle/manage/_board_create_form.html.twig', {form: boardFormFallback, id_prefix: 'nojs-'}) }}
                </div>
            </section>
        </noscript>
    {% endif %}
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {% if canCreateBoard|default(false) %}
        {% set _body %}
            {{ include('@NowoTaskBoardBundle/manage/_board_create_form.html.twig', {form: boardForm, in_dialog: true, with_actions: false}) }}
        {% endset %}
        {% set _footer %}
            {% if boardForm.scope is defined %}
                <button type="button" class="{{ nowo_ui_class('btn_secondary', page.bundle) }}" data-nowo-ui-dialog-back data-nowo-task-board-create-form="nowo-task-board-create-form" hidden>{{ 'task_board.action.back'|trans({}, 'NowoTaskBoardBundle') }}</button>
            {% endif %}
            <button type="button" class="{{ nowo_ui_class('btn_secondary', page.bundle) }}" data-nowo-ui-dialog-close>{{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}</button>
            <button type="submit" form="nowo-task-board-create-form" class="{{ nowo_ui_class('btn_primary', page.bundle) }}" data-testid="nowo-task-board-create-submit">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'plus'}) }}{{ 'task_board.action.create'|trans({}, 'NowoTaskBoardBundle') }}
            </button>
        {% endset %}
        {{ include(nowo_ui_partial('dialog', page.bundle), {
            id: constant('Nowo\\TaskBoardBundle\\Ui\\TaskBoardPages::BOARD_CREATE_DIALOG'),
            title: 'task_board.index.create_board'|trans({}, 'NowoTaskBoardBundle'),
            bundle: page.bundle,
            root_class: 'nowo-task-dialog nowo-task-dialog--native',
            attr: {'data-testid': 'nowo-task-board-create-dialog'},
            body: _body,
            footer: _footer,
            footer_attr: {class: 'nowo-task-dialog__footer nowo-task-dialog__actions'},
        }, false) }}
        {% if openCreateBoard|default(false) %}
            {{ include('@NowoUiKitBundle/partials/_open_modal_on_load.html.twig', {modal: constant('Nowo\\TaskBoardBundle\\Ui\\TaskBoardPages::BOARD_CREATE_DIALOG'), param: false}) }}
        {% endif %}
    {% endif %}
{% endblock %}
