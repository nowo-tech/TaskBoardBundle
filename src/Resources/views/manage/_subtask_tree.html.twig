{#
    The subtask tree (since 1.10, any depth, a done / total counter on every node). Since 2.0.0 UiKit's `tree` partial: an APG
    treeview with js/nowo-ui-tree.js, every group expanded in the markup, so without the script the whole tree shows (owner
    decision 2026-11-06). The check icon goes through leading_template, the counter, column and tags through actions_template.
    Variables: tasks (the first level), taskTree (one query; without it the partial walks task.subtasks), panel,
    panelTargetPath (the title then opens the subtask in the drawer).
#}
{% set _nodes = nowo_task_board_subtask_nodes(tasks, taskTree|default(null), panel|default(false), panelTargetPath|default('')) %}
{% if _nodes is empty %}
    <p class="nowo-task-subtree__empty nowo-task-detail__empty">{{ 'task_board.task.no_subtasks'|trans({}, 'NowoTaskBoardBundle') }}</p>
{% else %}
    <div class="nowo-task-subtree">
        {{ include(nowo_ui_partial('tree', 'NowoTaskBoardBundle'), {
            nodes: _nodes,
            label: 'task_board.task.subtasks'|trans({}, 'NowoTaskBoardBundle'),
            leading_template: '@NowoTaskBoardBundle/manage/_subtask_node_leading.html.twig',
            actions_template: '@NowoTaskBoardBundle/manage/_subtask_node_meta.html.twig',
            attr: {id: 'nowo-task-subtree-' ~ (_nodes|first).id},
            bundle: 'NowoTaskBoardBundle',
        }, false) }}
    </div>
{% endif %}
