{#
    Recursive subtask tree (since 1.10): any depth, a done / total counter on every node with subtasks, nested levels
    in <details> (expand / collapse without JavaScript).
    Variables:
      tasks     the nodes of this level (list of Task)
      taskTree  Nowo\TaskBoardBundle\Support\TaskTree built from the board's tasks (one query); without it the
                partial walks task.subtasks (a query per node)
      depth     level of `tasks` (default 0)
#}
{% set depth = depth|default(0) %}
{% set tree = taskTree|default(null) %}
<ul class="nowo-task-subtree" data-depth="{{ depth }}">
    {% for node in tasks %}
        {% set children = tree ? tree.childrenOf(node) : node.subtasks %}
        {% set progress = tree ? tree.progress(node) : nowo_task_board_subtask_progress(node) %}
        <li class="nowo-task-subtree__item{{ node.completed ? ' is-done' : '' }}" data-task-id="{{ node.id }}">
            <div class="nowo-task-subtree__row">
                <span class="nowo-task-subtree__check nowo-task-detail__subtask-check{{ node.completed ? ' is-done' : '' }}" aria-hidden="true">
                    {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: (node.completed ? 'circle-check' : 'circle')}) }}
                </span>
                <div class="nowo-task-subtree__body">
                    <a href="{{ path(nowo_task_board_route('task'), {taskId: node.id}) }}" class="nowo-task-subtree__title">{{ node.title }}</a>
                    {% if node.column %}
                        <span class="nowo-task-subtree__column badge bg-secondary-lt nowo-task-badge">{{ node.column.name }}</span>
                    {% endif %}
                    {% if progress.total > 0 %}
                        <span class="nowo-task-subtree__progress" title="{{ 'task_board.board.subtasks_count'|trans({'%done%': progress.done, '%total%': progress.total}, 'NowoTaskBoardBundle') }}">
                            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'subtask'}) }} {{ progress.done }}/{{ progress.total }}
                        </span>
                    {% endif %}
                    {{ include('@NowoTaskBoardBundle/manage/_task_tags.html.twig', {tags: node.tags, wrapper_class: 'nowo-task-subtree__tags'}) }}
                </div>
            </div>
            {% if children|length > 0 %}
                <details class="nowo-task-subtree__children" open>
                    <summary class="nowo-task-subtree__summary" data-controller="disclosure-icon">{{ include('@NowoTaskBoardBundle/manage/_disclosure.html.twig') }}{{ 'task_board.task.subtasks_progress'|trans({'%done%': progress.done, '%total%': progress.total}, 'NowoTaskBoardBundle') }}</summary>
                    {{ include('@NowoTaskBoardBundle/manage/_subtask_tree.html.twig', {tasks: children, depth: depth + 1}) }}
                </details>
            {% endif %}
        </li>
    {% else %}
        {% if depth == 0 %}
            <li class="nowo-task-subtree__empty nowo-task-detail__empty">{{ 'task_board.task.no_subtasks'|trans({}, 'NowoTaskBoardBundle') }}</li>
        {% endif %}
    {% endfor %}
</ul>
