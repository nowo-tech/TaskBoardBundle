{% import '@NowoTaskBoardBundle/manage/_task_member_label.html.twig' as memberUi %}
{#
    Since 1.16: one comment of the activity stream — author, time, "edited", the text with its mention chips (the viewer's
    highlighted), and for its author Edit (the comment box in place) / for its author or an editor Delete. A deleted
    comment keeps its place as "Comment deleted". Variables: comment, viewerId, commentEditForms, commentDeletable,
    taskRouteExtra.
#}
{% set _mine = viewerId|default(null) and comment.mentions(viewerId) %}
<li class="nowo-task-activity__item nowo-task-comment{{ comment.deleted ? ' is-deleted' : '' }}{{ _mine ? ' is-mentioning-me' : '' }}" data-kind="comment" data-comment-id="{{ comment.id }}">
    {{ include('@NowoTaskBoardBundle/manage/_task_member_avatar.html.twig', {user: comment.author, class: 'nowo-task-detail__history-avatar', size: 32, labelled: false}, with_context: false) }}
    <div class="nowo-task-activity__body nowo-task-comment__body">
        <div class="nowo-task-detail__history-summary">
            {# Since 1.25: an imported comment shows its remote author ("<name> (ClickUp)") instead of a prefix line. #}
            {% set _remote = task_board_sync_comment_author(comment) %}
            {% if _remote and _remote.external %}
                <strong>{{ 'task_board.sync.people.external'|trans({'%name%': _remote.name, '%provider%': ('task_board.sync.provider.' ~ _remote.provider)|trans({}, 'NowoTaskBoardBundle')}, 'NowoTaskBoardBundle') }}</strong>
                {% if _remote.boardAccess is same as(false) %}<span class="{{ nowo_ui_class('badge_neutral', 'NowoTaskBoardBundle') }} nowo-task-badge">{{ 'task_board.sync.people.no_board_access'|trans({}, 'NowoTaskBoardBundle') }}</span>{% endif %}
            {% elseif comment.author is null and comment.authorName %}
                {# Since 1.25 (audit FP-M1): the account is gone; the comment keeps the name it was written with. #}
                <strong>{{ comment.authorName }}</strong>
            {% else %}
                <strong>{{ memberUi.member_label(comment.author)|trim }}</strong>
            {% endif %}
            <time class="nowo-task-activity__time" datetime="{{ comment.createdAt|date('c') }}">{{ comment.createdAt|date('Y-m-d H:i') }}</time>
            {% if comment.editedAt and not comment.deleted %}<span class="nowo-task-comment__edited">{{ 'task_board.comment.edited'|trans({}, 'NowoTaskBoardBundle') }}</span>{% endif %}
            {# Since 1.27.0 (TB-SYNC-3): an imported reply, assigned comment (action item) and its resolved state. #}
            {% set _meta = task_board_sync_comment_meta(comment) %}
            {% if _meta %}
                {% if _meta.reply %}<span class="{{ nowo_ui_class('badge_neutral', 'NowoTaskBoardBundle') }} nowo-task-badge" data-sync-comment-reply>{{ (_meta.replyTo ? 'task_board.sync.comment.reply_to' : 'task_board.sync.comment.reply')|trans({'%name%': _meta.replyTo ? _meta.replyTo.name : ''}, 'NowoTaskBoardBundle') }}</span>{% endif %}
                {% if _meta.assignee %}<span class="{{ nowo_ui_class('badge_neutral', 'NowoTaskBoardBundle') }} nowo-task-badge" data-sync-comment-assigned>{{ 'task_board.sync.comment.assigned'|trans({'%name%': _meta.assignee.name}, 'NowoTaskBoardBundle') }}</span>{% endif %}
                {% if _meta.resolved is not null %}<span class="{{ nowo_ui_class('badge_neutral', 'NowoTaskBoardBundle') }} nowo-task-badge" data-sync-comment-resolved="{{ _meta.resolved ? '1' : '0' }}">{{ (_meta.resolved ? 'task_board.sync.comment.resolved' : 'task_board.sync.comment.open')|trans({}, 'NowoTaskBoardBundle') }}</span>{% endif %}
                {% if _meta.remoteEditedAt %}<span class="nowo-task-comment__edited">{{ 'task_board.sync.comment.edited_remote'|trans({'%date%': _meta.remoteEditedAt|date('Y-m-d H:i')}, 'NowoTaskBoardBundle') }}</span>{% endif %}
            {% endif %}
            {% if _mine %}<span class="nowo-task-sr-only">{{ 'task_board.comment.mentions_you'|trans({}, 'NowoTaskBoardBundle') }}</span>{% endif %}
        </div>
        {% if comment.deleted %}
            <p class="nowo-task-comment__text nowo-task-detail__empty">{{ 'task_board.comment.deleted'|trans({}, 'NowoTaskBoardBundle') }}</p>
        {% else %}
            <div class="nowo-task-comment__text" data-comment-text>{{ nowo_task_board_comment_body(comment, viewerId|default(null)) }}</div>
            {% set _editForm = commentEditForms[comment.id] ?? null %}
            {% set _deletable = commentDeletable[comment.id] ?? false %}
            {% if _editForm or _deletable %}
                <div class="nowo-task-comment__actions">
                    {% if _editForm %}
                        <button type="button" class="{{ nowo_ui_class('btn_sm', 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-action="nowo-task-board-activity-filter#edit" aria-expanded="false" aria-controls="nowo-task-comment-edit-{{ comment.id }}">
                            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'pencil'}) }}{{ 'task_board.comment.edit'|trans({}, 'NowoTaskBoardBundle') }}
                        </button>
                    {% endif %}
                    {% if _deletable %}
                        <button
                            type="submit"
                            form="nowo-task-comment-delete-form"
                            formaction="{{ path(nowo_task_board_route('task_comment_delete'), {taskId: comment.task.id, commentId: comment.id}|merge(taskRouteExtra|default({}))) }}"
                            class="{{ nowo_ui_class('btn_sm', 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}"
                            data-confirm="{{ 'task_board.comment.delete_confirm'|trans({}, 'NowoTaskBoardBundle') }}"
                        >
                            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'trash'}) }}{{ 'task_board.comment.delete'|trans({}, 'NowoTaskBoardBundle') }}
                        </button>
                    {% endif %}
                </div>
                {% if _editForm %}
                    <div class="nowo-task-comment__edit" id="nowo-task-comment-edit-{{ comment.id }}" hidden>
                        {{ include('@NowoTaskBoardBundle/manage/_task_comment_box.html.twig', {form: _editForm, submitLabel: 'task_board.action.save', cancelEdit: true}) }}
                    </div>
                {% endif %}
            {% endif %}
        {% endif %}
    </div>
</li>
