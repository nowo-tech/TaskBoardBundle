{% import '@NowoTaskBoardBundle/manage/_task_priority_tag.html.twig' as priorityUi %}

{# "Change priority" dialog. Since 1.14 a native <dialog> styled by task-board.css (no CSS framework modal). #}
<dialog
    class="nowo-task-dialog nowo-task-dialog--native"
    data-nowo-task-board-task-priority-modal-target="modal"
    aria-labelledby="nowo-task-board-task-priority-modal-title"
>
    <div class="nowo-task-dialog__header">
        <h2 class="nowo-task-dialog__title" id="nowo-task-board-task-priority-modal-title">
            {{ 'task_board.task.priority_modal_title'|trans({}, 'NowoTaskBoardBundle') }}
        </h2>
        <button type="button" class="nowo-task-dialog__close" aria-label="{{ 'task_board.action.close'|trans({}, 'NowoTaskBoardBundle') }}" data-action="click->nowo-task-board-task-priority-modal#close">
            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'x'}) }}
        </button>
    </div>
    {# Plain radio widgets: the option label is the custom priority tag below, not the theme's form-check label. #}
    {% form_theme priorityForm 'form_div_layout.html.twig' %}
    {{ form_start(priorityForm, {attr: {class: 'nowo-task-dialog__body'}}) }}
        <p class="nowo-task-dialog__help">{{ 'task_board.task.priority_modal_help'|trans({}, 'NowoTaskBoardBundle') }}</p>
        <div class="nowo-task-detail__priority-options">
            {% for priority in priorities %}
                {% set _optionAttr = {class: 'nowo-task-detail__priority-radio', 'data-action': 'change->nowo-task-board-task-priority-modal#select'} %}
                <label class="nowo-task-detail__priority-option{% if task.priority == priority %} is-selected{% endif %}">
                    {{ form_widget(priorityForm.priority[loop.index0], {attr: loop.first ? _optionAttr|merge({'data-nowo-task-board-task-priority-modal-target': 'firstOption'}) : _optionAttr}) }}
                    <span class="nowo-task-detail__priority-option-content">
                        {{ priorityUi.priority_tag(priority, false) }}
                    </span>
                </label>
            {% endfor %}
        </div>
        {# REQ-TWIG-005: remaining children (CSRF token) #}
        {% for child in priorityForm %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
        <div class="nowo-task-dialog__actions">
            <button type="button" class="btn btn-outline-secondary" data-action="click->nowo-task-board-task-priority-modal#close">
                {{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}
            </button>
            <button type="submit" class="btn btn-primary">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'device-floppy'}) }}{{ 'task_board.action.save'|trans({}, 'NowoTaskBoardBundle') }}
            </button>
        </div>
    {{ form_end(priorityForm) }}
</dialog>
