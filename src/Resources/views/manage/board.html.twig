{% extends nowo_task_board_page_layout() ?? nowo_ui_layout.admin %}
{% set nowo_ui_bundle = 'NowoTaskBoardBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/task-board.css', 'nowo_task_board') }}">
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('js/nowo-ui-show-more.js', 'nowo_ui_kit') }}" defer></script>
    <script src="{{ asset('js/task-board.js', 'nowo_task_board') }}" defer></script>
{% endblock %}

{% block nowo_ui_document_title %}{{ board.name }} — {{ 'task_board.board.title'|trans({}, 'NowoTaskBoardBundle') }}{% endblock %}

{% block nowo_ui_page_header %}
    {% block nowo_task_board_toolbar %}
    {{ nowo_ui_page_header(nowo_task_board_header({
        title: nowo_task_board_label(board),
        intro: board.descriptionFormat == 'markdown' ? null : board.description,
        crumb: {href: path(nowo_task_board_route('index'), {}), label: 'task_board.index.title'|trans({}, 'NowoTaskBoardBundle')},
        actions: ((canEditBoard ?? true) ? [
            {href: path(nowo_task_board_route('board_import'), {boardId: board.id}), icon: 'upload', label: 'task_board.import.action'|trans({}, 'NowoTaskBoardBundle')},
        ] : [])|merge([
            {href: path(nowo_task_board_route('list'), {boardId: board.id}), icon: 'list', label: 'task_board.view.list'|trans({}, 'NowoTaskBoardBundle')},
            {href: path(nowo_task_board_route('gantt'), {boardId: board.id}), icon: 'chart-bar', label: 'task_board.view.gantt'|trans({}, 'NowoTaskBoardBundle')},
        ]),
        back: dashboardRoute|default(null) ? path(dashboardRoute) : null,
    })) }}
    {% endblock %}
{% endblock %}

{% block nowo_ui_content %}
    {% if board.description and board.descriptionFormat == 'markdown' %}
        {{ include('@NowoTaskBoardBundle/manage/_board_description.html.twig', {board: board}) }}
    {% endif %}

    {# Since 1.23: the board's provider connection (badge, Refresh, Connect provider); nothing without sync. #}
    {% block nowo_task_board_connection %}
        {{ include(nowo_task_board_connection_badge_template|default('@NowoTaskBoardBundle/manage/_connection_badge.html.twig'), {sync: nowo_task_board_connection(board)}) }}
    {% endblock %}

    {{ include('@NowoTaskBoardBundle/manage/_task_window_notice.html.twig') }}

    <div
        data-controller="nowo-task-board-add-task-modal nowo-task-board-add-column-modal nowo-task-board-edit-column-modal"
        data-nowo-task-board-add-task-modal-title-format-value="{{ 'task_board.board.add_task_modal_title'|trans({}, 'NowoTaskBoardBundle')|e('html_attr') }}"
        data-nowo-task-board-edit-column-modal-update-url-template-value="{{ path(nowo_task_board_route('column_update'), {boardId: board.id, columnId: 'COLUMN_ID'})|e('html_attr') }}"
        data-nowo-task-board-edit-column-modal-title-template-value="{{ 'task_board.board.edit_column_title'|trans({'%column%': '%column%'}, 'NowoTaskBoardBundle')|e('html_attr') }}"
        data-nowo-task-board-edit-column-modal-delete-url-template-value="{{ path(nowo_task_board_route('column_delete'), {boardId: board.id, columnId: 'COLUMN_ID'})|e('html_attr') }}"
    >
        <div class="nowo-task-board__toolbar">
            {% if (canEditBoard ?? true) %}
            <p class="nowo-task-board__hint">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'arrows-sort'}) }} {{ 'task_board.board.reorder_hint'|trans({}, 'NowoTaskBoardBundle') }}
            </p>
            {# Since 1.11: column sets (save this board's columns, add the columns of a set). #}
            {% if columnSetForm is defined and columnSetApplyForm is defined %}
                {{ include('@NowoTaskBoardBundle/manage/_column_sets_dialogs.html.twig') }}
            {% endif %}
            {% endif %}
        </div>

        <div
            class="nowo-task-board"
            data-controller="nowo-task-board"
            data-nowo-task-board-reorder-url-value="{{ path(nowo_task_board_route('column_reorder'), {boardId: board.id}) }}"
            data-nowo-task-board-reorder-csrf-token-value="{{ csrf_token('task_board_column_reorder') }}"
            data-nowo-task-board-move-csrf-token-value="{{ csrf_token('task_board_task_move') }}"
        >
            {% block nowo_task_board_columns %}
                {% for column in board.columns %}
                    {% block nowo_task_board_column %}
                        {{ include('@NowoTaskBoardBundle/manage/_board_column.html.twig', {column: column}) }}
                    {% endblock %}
                {% endfor %}
            {% endblock %}

            {% if (canEditBoard ?? true) %}
            <div class="nowo-task-board__add-column">
                <button
                    type="button"
                    class="{{ nowo_ui_class('btn_icon', 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }} nowo-task-board__add-column-btn"
                    data-action="click->nowo-task-board-add-column-modal#open"
                    title="{{ 'task_board.board.add_column'|trans({}, 'NowoTaskBoardBundle') }}"
                    aria-label="{{ 'task_board.board.add_column'|trans({}, 'NowoTaskBoardBundle') }}"
                >
                    {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'plus'}) }}
                </button>
            </div>
            {% endif %}
        </div>

        {% if (canEditBoard ?? true) %}
            {{ include('@NowoTaskBoardBundle/manage/_add_task_modal.html.twig') }}
            {{ include('@NowoTaskBoardBundle/manage/_add_column_modal.html.twig') }}
            {{ include('@NowoTaskBoardBundle/manage/_edit_column_modal.html.twig') }}
        {% endif %}
    </div>
{% endblock %}
