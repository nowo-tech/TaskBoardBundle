{% extends nowo_task_board_page_layout() ?? nowo_ui_layout.admin %}
{% set nowo_ui_bundle = 'NowoTaskBoardBundle' %}
{#
    Since 1.27.0 (TB-SYNC-2): the People page of a linked board — each remote person (assignees, creators, watchers,
    commenters, time-entry users, workspace members) with a host-user select pre-filled by e-mail, then by name. Saving
    maps the changed rows and re-applies them to the tasks already imported. During the People step (sync.people.step)
    the save starts the first import. Remote names and e-mails are untrusted text (escaped) and shown only to managers.
    board, connection, provider, directory, rows, peopleForm, filter, page, hasNext, peopleSummary, pendingReassigns,
    firstImportPending. Override with templates.connection_people.
    Since 2.5.0 (TB-12): UiKit only — the filter is the kit's `tabs` partial (level secondary), the person's initials the
    kit's `avatar` partial; no framework (Bootstrap) classes.
#}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/task-board.css', 'nowo_task_board') }}">
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('js/task-board.js', 'nowo_task_board') }}" defer></script>
{% endblock %}

{% block nowo_ui_document_title %}{{ 'task_board.sync.people.title'|trans({}, 'NowoTaskBoardBundle') }} — {{ board.name }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _provider = (provider ? provider.labelKey : 'task_board.sync.provider.unknown')|trans({}, 'NowoTaskBoardBundle') %}
    {{ nowo_ui_page_header(nowo_task_board_header({
        title: 'task_board.sync.people.title'|trans({}, 'NowoTaskBoardBundle'),
        intro: 'task_board.sync.people.subtitle'|trans({'%provider%': _provider}, 'NowoTaskBoardBundle'),
        crumb: {href: path(nowo_task_board_route('board'), {boardId: board.id}), label: (board.icon ? board.icon ~ ' ' : '') ~ board.name},
        actions: [
            {href: path(nowo_task_board_route('board_connection'), {boardId: board.id}), icon: 'arrow-left', label: 'task_board.sync.page.link'|trans({}, 'NowoTaskBoardBundle')},
        ],
        back: dashboardRoute|default(null) ? path(dashboardRoute) : null,
    })) }}
{% endblock %}

{% block nowo_ui_content %}
    {% set _provider = (provider ? provider.labelKey : 'task_board.sync.provider.unknown')|trans({}, 'NowoTaskBoardBundle') %}

    {% block nowo_task_board_connection_people %}
        <section class="{{ nowo_ui_class('card', 'NowoTaskBoardBundle') }} nowo-task-sync-people" aria-labelledby="nowo-task-sync-people-title" data-testid="nowo-task-sync-people">
            <div class="{{ nowo_ui_class('card_header', 'NowoTaskBoardBundle') }}">
                <h2 class="{{ nowo_ui_class('card_title', 'NowoTaskBoardBundle') }}" id="nowo-task-sync-people-title">{{ _provider }} · {{ connection.containerLabel }}</h2>
            </div>
            <div class="{{ nowo_ui_class('card_body', 'NowoTaskBoardBundle') }}">
                {% if firstImportPending %}
                    <p class="{{ nowo_ui_class('flash_info', 'NowoTaskBoardBundle') }}" data-testid="nowo-task-sync-people-step">{{ 'task_board.sync.people.step_help'|trans({'%provider%': _provider}, 'NowoTaskBoardBundle') }}</p>
                {% endif %}
                <p class="{{ nowo_ui_class('muted', 'NowoTaskBoardBundle') }}">{{ 'task_board.sync.people.help'|trans({'%provider%': _provider}, 'NowoTaskBoardBundle') }}</p>
                {% if pendingReassigns > 0 %}
                    <p class="{{ nowo_ui_class('flash_warning', 'NowoTaskBoardBundle') }}" role="status" data-testid="nowo-task-sync-people-pending">{{ 'task_board.sync.people.pending'|trans({'%count%': pendingReassigns}, 'NowoTaskBoardBundle') }}</p>
                {% endif %}

                {% if directory is null %}
                    <p class="{{ nowo_ui_class('muted', 'NowoTaskBoardBundle') }}" data-testid="nowo-task-sync-people-none">{{ 'task_board.sync.people.none_yet'|trans({'%provider%': _provider}, 'NowoTaskBoardBundle') }}</p>
                {% else %}
                    {#- Since 2.5.0 (TB-12): the filter as UiKit's secondary tabs (pills / sub-nav), no framework classes. -#}
                    {% set _filter_items = [] %}
                    {% for _f in ['all', 'unmapped'] %}
                        {% set _filter_items = _filter_items|merge([{label: ('task_board.sync.people.filter.' ~ _f)|trans({}, 'NowoTaskBoardBundle'), href: path(nowo_task_board_route('board_connection_people'), {boardId: board.id, filter: _f}), current: filter == _f}]) %}
                    {% endfor %}
                    {{ include(nowo_ui_partial('tabs', 'NowoTaskBoardBundle'), {items: _filter_items, aria_label: 'task_board.sync.people.filter'|trans({}, 'NowoTaskBoardBundle'), level: 'secondary', bundle: 'NowoTaskBoardBundle', attr: {'data-testid': 'nowo-task-sync-people-filter'}}, with_context: false) }}

                    {% if rows is empty %}
                        <p class="{{ nowo_ui_class('muted', 'NowoTaskBoardBundle') }}" data-testid="nowo-task-sync-people-empty">{{ 'task_board.sync.people.empty'|trans({}, 'NowoTaskBoardBundle') }}</p>
                    {% endif %}

                    {{ form_start(peopleForm, {method: 'POST', attr: {id: 'nowo-task-sync-people-form'}}) }}
                        {% if rows is not empty %}
                            {#- A scrolling region is reachable with the keyboard (WCAG 2.1.1). -#}
                            <div class="{{ nowo_ui_class('table_wrap', 'NowoTaskBoardBundle') }}" tabindex="0" role="region" aria-labelledby="nowo-task-sync-people-title">
                                <table class="{{ nowo_ui_class('table', 'NowoTaskBoardBundle') }}">
                                    <caption class="nowo-task-sr-only">{{ 'task_board.sync.people.caption'|trans({}, 'NowoTaskBoardBundle') }}</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">{{ 'task_board.sync.people.col_person'|trans({'%provider%': _provider}, 'NowoTaskBoardBundle') }}</th>
                                            <th scope="col">{{ 'task_board.sync.people.col_user'|trans({}, 'NowoTaskBoardBundle') }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for row in rows %}
                                            {% set _person = row.person %}
                                            <tr data-testid="nowo-task-sync-person-row">
                                                <td>
                                                    <div class="nowo-task-flex nowo-task-center nowo-task-gap">
                                                        {{ include('@NowoUiKitBundle/partials/_avatar.html.twig', {name: _person.name, initials: _person.name|slice(0, 1)|upper, decorative: true, size: 'sm'}, with_context: false) }}
                                                        <div>
                                                            <div id="nowo-task-sync-person-{{ _person.id }}">{{ _person.name }}</div>
                                                            {% if _person.email %}<div class="{{ nowo_ui_class('muted', 'NowoTaskBoardBundle') }} nowo-task-small">{{ _person.email }}</div>{% endif %}
                                                            <div class="nowo-task-small">
                                                                {% if row.prefill == 'name' %}
                                                                    <span class="{{ nowo_ui_class('badge_warning', 'NowoTaskBoardBundle') }}" data-testid="nowo-task-sync-person-suggestion">{{ 'task_board.sync.people.prefill.name_suggestion'|trans({'%user%': candidateLabels[row.suggestedUserId]|default('')}, 'NowoTaskBoardBundle') }}</span>
                                                                {% elseif row.prefill == 'email' %}
                                                                    <span class="{{ nowo_ui_class('badge_warning', 'NowoTaskBoardBundle') }}" data-testid="nowo-task-sync-person-prefill">{{ ('task_board.sync.people.prefill.' ~ row.prefill)|trans({}, 'NowoTaskBoardBundle') }}</span>
                                                                {% elseif row.prefill == 'mapped' %}
                                                                    <span class="{{ nowo_ui_class('badge_success', 'NowoTaskBoardBundle') }}">{{ ('task_board.sync.people.state.' ~ _person.mapping.value)|trans({}, 'NowoTaskBoardBundle') }}</span>
                                                                {% elseif row.prefill == 'external' %}
                                                                    <span class="{{ nowo_ui_class('badge_neutral', 'NowoTaskBoardBundle') }}">{{ 'task_board.sync.people.state.external'|trans({}, 'NowoTaskBoardBundle') }}</span>
                                                                {% endif %}
                                                                {% if row.pending %}
                                                                    <span class="{{ nowo_ui_class('badge_warning', 'NowoTaskBoardBundle') }}">{{ 'task_board.sync.people.reapplying'|trans({}, 'NowoTaskBoardBundle') }}</span>
                                                                {% endif %}
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>{{ form_widget(peopleForm['p_' ~ _person.id]) }}{{ form_errors(peopleForm['p_' ~ _person.id]) }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                        <div class="nowo-task-flex nowo-task-wrap nowo-task-gap nowo-task-center nowo-task-mt-3">
                            {% if rows is not empty or firstImportPending %}
                                <button type="submit" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}" data-testid="nowo-task-sync-people-save">
                                    {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'device-floppy'}) }}{{ (firstImportPending ? 'task_board.sync.people.save_import' : 'task_board.sync.people.save')|trans({}, 'NowoTaskBoardBundle') }}
                                </button>
                            {% endif %}
                            {% if firstImportPending %}
                                <button type="submit" name="skip" value="1" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-testid="nowo-task-sync-people-skip">{{ 'task_board.sync.people.skip'|trans({}, 'NowoTaskBoardBundle') }}</button>
                            {% endif %}
                        </div>
                    {{ form_end(peopleForm) }}

                    {% if peopleFormerForm|default(null) %}
                        {#- Since 1.28.0 (sync.people_bulk_former). -#}
                        {{ form_start(peopleFormerForm, {method: 'POST', attr: {class: 'nowo-task-mt-3'}}) }}
                            <p class="{{ nowo_ui_class('muted', 'NowoTaskBoardBundle') }} nowo-task-small nowo-task-mb-2">{{ 'task_board.sync.people.former_help'|trans({}, 'NowoTaskBoardBundle') }}</p>
                            <button type="submit" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-testid="nowo-task-sync-people-former">{{ 'task_board.sync.people.former_all'|trans({}, 'NowoTaskBoardBundle') }}</button>
                        {{ form_end(peopleFormerForm) }}
                    {% endif %}

                    {% if page > 1 or hasNext %}
                        <nav class="nowo-task-flex nowo-task-gap nowo-task-mt-3" aria-label="{{ 'task_board.sync.people.pages'|trans({}, 'NowoTaskBoardBundle') }}">
                            {% if page > 1 %}<a class="{{ nowo_ui_class('btn_sm', 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" href="{{ path(nowo_task_board_route('board_connection_people'), {boardId: board.id, filter: filter, page: page - 1}) }}">{{ 'task_board.sync.people.previous'|trans({}, 'NowoTaskBoardBundle') }}</a>{% endif %}
                            {% if hasNext %}<a class="{{ nowo_ui_class('btn_sm', 'NowoTaskBoardBundle') }} {{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" href="{{ path(nowo_task_board_route('board_connection_people'), {boardId: board.id, filter: filter, page: page + 1}) }}" data-testid="nowo-task-sync-people-next">{{ 'task_board.sync.people.next'|trans({}, 'NowoTaskBoardBundle') }}</a>{% endif %}
                        </nav>
                    {% endif %}
                {% endif %}
            </div>
        </section>
    {% endblock %}
{% endblock %}
