{#
    Edit column dialog: name, colour and (since 1.11, with board.column_icons) icon; since 1.11 also "Delete column"
    (columnDeleteForm, its tasks move to the first remaining column) when the board has more than one column.
    Since 1.13 a native <dialog> styled by task-board.css, with the colour palette and icon grid of
    _column_fields.html.twig. Since 1.26 (dialog rule v2) one primary: the footer, outside the scrolling form, holds
    Delete column (secondary, danger outline, bound with form="nowo-task-board-column-delete-form" to the hidden delete
    form, which keeps its confirm) on the left, then Cancel and Save (form="nowo-task-board-edit-column-form").
#}
{% set _canDelete = (columnDeleteForm ?? null) is not null and board.columns|length > 1 %}
<dialog
    class="nowo-task-dialog nowo-task-dialog--native"
    data-nowo-task-board-edit-column-modal-target="modal"
    aria-labelledby="nowo-task-board-edit-column-modal-title"
>
    <div class="nowo-task-dialog__header">
        <h2 class="nowo-task-dialog__title" id="nowo-task-board-edit-column-modal-title" data-nowo-task-board-edit-column-modal-target="title">
            {{ 'task_board.board.edit_column'|trans({}, 'NowoTaskBoardBundle') }}
        </h2>
        <button type="button" class="nowo-task-dialog__close" aria-label="{{ 'task_board.action.close'|trans({}, 'NowoTaskBoardBundle') }}" data-action="click->nowo-task-board-edit-column-modal#close">
            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'x'}) }}
        </button>
    </div>
    {{ form_start(editColumnForm, {
        attr: {
            id: 'nowo-task-board-edit-column-form',
            class: 'nowo-task-dialog__body',
            'data-nowo-task-board-edit-column-modal-target': 'form',
        },
    }) }}
        {{ include('@NowoTaskBoardBundle/manage/_column_fields.html.twig', {form: editColumnForm, controller: 'nowo-task-board-edit-column-modal'}) }}
        {% for child in editColumnForm %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
        {% if _canDelete %}
            <p class="nowo-task-dialog__help nowo-task-dialog__danger-help" id="nowo-task-board-column-delete-help">{{ 'task_board.board.delete_column_help'|trans({}, 'NowoTaskBoardBundle') }}</p>
        {% endif %}
    {{ form_end(editColumnForm) }}
    {% if _canDelete %}
        {{ form_start(columnDeleteForm, {action: '#', attr: {
            id: 'nowo-task-board-column-delete-form',
            class: 'nowo-task-column-delete-form',
            hidden: 'hidden',
            'data-nowo-task-board-edit-column-modal-target': 'deleteForm',
            'data-action': 'submit->nowo-task-board-edit-column-modal#confirmDelete',
            'data-confirm': 'task_board.board.delete_column_confirm'|trans({}, 'NowoTaskBoardBundle'),
        }}) }}
            {% for child in columnDeleteForm %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        {{ form_end(columnDeleteForm) }}
    {% endif %}
    <div class="nowo-task-dialog__footer nowo-task-dialog__actions{% if _canDelete %} nowo-task-dialog__actions--split{% endif %}">
        {% if _canDelete %}
            <button type="submit" form="nowo-task-board-column-delete-form" class="{{ nowo_task_board_btn_class('btn_danger') }} nowo-task-btn-danger" aria-describedby="nowo-task-board-column-delete-help">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'trash'}) }}{{ 'task_board.action.delete_column'|trans({}, 'NowoTaskBoardBundle') }}
            </button>
        {% endif %}
        <div class="nowo-task-dialog__actions-end">
            <button type="button" class="{{ nowo_task_board_btn_class('btn_secondary') }}" data-action="click->nowo-task-board-edit-column-modal#close">
                {{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}
            </button>
            <button type="submit" form="nowo-task-board-edit-column-form" class="{{ nowo_task_board_btn_class('btn_primary') }}">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'device-floppy'}) }}{{ 'task_board.action.save'|trans({}, 'NowoTaskBoardBundle') }}
            </button>
        </div>
    </div>
</dialog>
