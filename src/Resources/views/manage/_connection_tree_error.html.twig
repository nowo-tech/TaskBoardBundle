{# Since 1.23: why a level of the container browser could not be read (never the provider's answer). #}
<div class="alert alert-danger" role="alert" data-testid="nowo-task-sync-tree-error">
    {{ ('task_board.sync.error.' ~ error)|trans({}, 'NowoTaskBoardBundle') }}
    {% if credentialFormUrl|default(null) and error in ['auth_failed', 'forbidden'] %}
        <a href="{{ credentialFormUrl }}" class="alert-link">{{ 'task_board.sync.connect.replace_token'|trans({}, 'NowoTaskBoardBundle') }}</a>
    {% endif %}
</div>
