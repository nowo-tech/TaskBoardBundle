{#
    Task page (web_ui.templates.task). Since 2.0.0 on the UiKit show scaffold; variable page (ShowPage). The trail, the actions
    and the editable title stay in nowo_task_toolbar and the edit form, so the scaffold's header stays empty: the title is a
    field. Blocks: nowo_task_body and the blocks of _task_blocks.html.twig.
#}
{% extends '@NowoUiKitBundle/page/show.html.twig' %}
{% use '@NowoTaskBoardBundle/manage/_task_blocks.html.twig' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/task-board.css', 'nowo_task_board') }}">
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('js/nowo-ui-tree.js', 'nowo_ui_kit') }}" defer></script>
    {% if nowo_task_board_numbers_enabled() %}<script src="{{ asset('js/nowo-ui-clipboard.js', 'nowo_ui_kit') }}" defer></script>{% endif %}<script src="{{ asset('js/task-board.js', 'nowo_task_board') }}" defer></script>
{% endblock %}

{% block nowo_ui_document_title %}{{ task.title }}{% endblock %}

{% block nowo_ui_page_header %}{% endblock %}

{% block nowo_ui_show_after %}
    {# Since 1.25.1: stable hook of the task page for integrations (e.g. the TimeTrack browser extension). Only the
       page has it: the panel fragment (task_panel.html.twig) carries its own hook. #}
    <div class="nowo-task-page" data-task-id="{{ task.id }}">
        {{ block('nowo_task_body') }}
    </div>
{% endblock %}
