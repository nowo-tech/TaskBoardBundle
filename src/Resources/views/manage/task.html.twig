{% extends nowo_task_board_layout %}
{% use '@NowoTaskBoardBundle/manage/_task_blocks.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    <link rel="stylesheet" href="{{ asset('css/task-board.css', 'nowo_task_board') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/task-board.js', 'nowo_task_board') }}" defer></script>
{% endblock %}

{% block title %}{{ task.title }}{% endblock %}

{% block container_class %}container container-narrow{% endblock %}

{% block body %}
    {# Since 1.25.1: stable hook of the task page for integrations (e.g. the TimeTrack browser extension). Only the
       page has it: the panel fragment (task_panel.html.twig) carries its own .nowo-task-panel-fragment hook. #}
    <div class="nowo-task-page" data-task-id="{{ task.id }}">
        {{ block('nowo_task_body') }}
    </div>
{% endblock %}
