{#
    Add column dialog. Since 3.6.0 (owner rule 2026-11-23, every dialog loads its content on demand) the content of the GET
    of `column_new`, answered as a fragment for UiKit's remote dialog: name, colour palette and icon grid
    (_column_fields.html.twig). Cancel and Add column sit in the footer, outside the scrolling form
    (form="nowo-task-board-add-column-form").
#}
{% set _body %}
    {{ form_start(columnForm, {
        action: path(nowo_task_board_route('column_create'), {boardId: board.id}),
        method: 'POST',
        attr: {id: 'nowo-task-board-add-column-form', class: 'nowo-task-dialog__body'},
    }) }}
        {{ include('@NowoTaskBoardBundle/manage/_column_fields.html.twig', {form: columnForm, controller: 'nowo-task-board-add-column-modal', defaultColor: '#64748b'}) }}
        {% for child in columnForm %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(columnForm) }}
{% endset %}
{% set _footer %}
        <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-nowo-ui-dialog-close>
            {{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}
        </button>
        <button type="submit" form="nowo-task-board-add-column-form" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}">
            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'layout-columns'}) }}{{ 'task_board.action.add_column'|trans({}, 'NowoTaskBoardBundle') }}
        </button>
{% endset %}
{{ _body }}
<div class="nowo-task-dialog__footer nowo-task-dialog__actions" data-nowo-ui-dialog-actions>{{ _footer }}</div>
