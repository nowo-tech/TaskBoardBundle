{#
    Add column dialog (since 1.13 a native <dialog>, styled by task-board.css: no CSS framework modal needed): name,
    colour palette and icon grid (_column_fields.html.twig). Since 1.26 (dialog rule v2) the actions sit in the footer,
    outside the scrolling form (form="nowo-task-board-add-column-form").
#}
<dialog
    class="nowo-task-dialog nowo-task-dialog--native"
    data-nowo-task-board-add-column-modal-target="modal"
    aria-labelledby="nowo-task-board-add-column-modal-title"
>
    <div class="nowo-task-dialog__header">
        <h2 class="nowo-task-dialog__title" id="nowo-task-board-add-column-modal-title">{{ 'task_board.board.add_column'|trans({}, 'NowoTaskBoardBundle') }}</h2>
        <button type="button" class="nowo-task-dialog__close" aria-label="{{ 'task_board.action.close'|trans({}, 'NowoTaskBoardBundle') }}" data-action="click->nowo-task-board-add-column-modal#close">
            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'x'}) }}
        </button>
    </div>
    {{ form_start(columnForm, {
        action: path(nowo_task_board_route('column_create'), {boardId: board.id}),
        method: 'POST',
        attr: {id: 'nowo-task-board-add-column-form', class: 'nowo-task-dialog__body'},
    }) }}
        {{ include('@NowoTaskBoardBundle/manage/_column_fields.html.twig', {form: columnForm, controller: 'nowo-task-board-add-column-modal', defaultColor: '#64748b'}) }}
        {% for child in columnForm %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(columnForm) }}
    <div class="nowo-task-dialog__footer nowo-task-dialog__actions">
        <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-action="click->nowo-task-board-add-column-modal#close">
            {{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}
        </button>
        <button type="submit" form="nowo-task-board-add-column-form" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}">
            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'layout-columns'}) }}{{ 'task_board.action.add_column'|trans({}, 'NowoTaskBoardBundle') }}
        </button>
    </div>
</dialog>
