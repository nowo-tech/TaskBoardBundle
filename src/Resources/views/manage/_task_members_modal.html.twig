{% import '@NowoTaskBoardBundle/manage/_task_member_label.html.twig' as memberUi %}

{#
    "Manage people" dialog. Since 1.14 a native <dialog> styled by task-board.css (no CSS framework modal): the members
    as a list (avatar initial, name, role, remove button on one line) and the add form as one row (person, role). Since
    1.16.1 Close and Add member share the footer, like the other dialogs (the submit button names its form).
#}
<dialog
    class="nowo-task-dialog nowo-task-dialog--native nowo-task-dialog--wide"
    data-nowo-task-board-task-members-modal-target="modal"
    aria-labelledby="nowo-task-board-task-members-modal-title"
>
    <div class="nowo-task-dialog__header">
        <h2 class="nowo-task-dialog__title" id="nowo-task-board-task-members-modal-title">
            {{ 'task_board.task.members_modal_title'|trans({}, 'NowoTaskBoardBundle') }}
        </h2>
        <button type="button" class="nowo-task-dialog__close" aria-label="{{ 'task_board.action.close'|trans({}, 'NowoTaskBoardBundle') }}" data-action="click->nowo-task-board-task-members-modal#close">
            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'x'}) }}
        </button>
    </div>
    <div class="nowo-task-dialog__body">
        <section class="nowo-task-dialog__section" aria-labelledby="nowo-task-board-task-members-current">
            <h3 class="nowo-task-dialog__section-title" id="nowo-task-board-task-members-current">{{ 'task_board.task.current_members'|trans({}, 'NowoTaskBoardBundle') }}</h3>
            <ul class="nowo-task-members">
                {% for member in task.members %}
                    {% set _name = memberUi.member_label(member.user)|trim %}
                    <li class="nowo-task-members__item">
                        <span class="nowo-task-members__avatar" aria-hidden="true">{{ _name|slice(0, 1)|upper }}</span>
                        <span class="nowo-task-members__name">{{ _name }}</span>
                        <span class="nowo-task-members__role nowo-task-members__role--{{ member.memberRole.value }}">{{ ('task_board.member.' ~ member.memberRole.value)|trans({}, 'NowoTaskBoardBundle') }}</span>
                        {% set member_remove_form = memberRemoveForms[member.id] %}
                        {{ form_start(member_remove_form, {attr: {class: 'nowo-task-members__remove'}}) }}
                            {% for child in member_remove_form %}
                                {% if not child.rendered %}
                                    {{ form_row(child) }}
                                {% endif %}
                            {% endfor %}
                            <button type="submit" class="btn btn-sm btn-outline-danger nowo-task-btn-danger nowo-task-members__remove-button" title="{{ 'task_board.action.remove_member'|trans({}, 'NowoTaskBoardBundle') }}">
                                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'user-minus'}) }}<span class="nowo-task-sr-only">{{ 'task_board.action.remove_member'|trans({}, 'NowoTaskBoardBundle') }} {{ _name }}</span>
                            </button>
                        {{ form_end(member_remove_form) }}
                    </li>
                {% else %}
                    <li class="nowo-task-members__item nowo-task-members__item--empty">{{ 'task_board.task.no_members'|trans({}, 'NowoTaskBoardBundle') }}</li>
                {% endfor %}
            </ul>
        </section>

        <section class="nowo-task-dialog__section" aria-labelledby="nowo-task-board-task-members-add">
            <h3 class="nowo-task-dialog__section-title" id="nowo-task-board-task-members-add">{{ 'task_board.task.add_member'|trans({}, 'NowoTaskBoardBundle') }}</h3>
            {{ form_start(memberForm, {action: path(nowo_task_board_route('task_member'), {taskId: task.id}|merge(taskRouteExtra|default({}))), method: 'POST', attr: {class: 'nowo-task-members__add', id: 'nowo-task-members-add-' ~ task.id}}) }}
                <div class="nowo-task-field nowo-task-members__add-user">
                    {{ form_label(memberForm.user) }}
                    {{ form_widget(memberForm.user, {attr: {'data-nowo-task-board-task-members-modal-target': 'userField'}}) }}
                    {{ form_errors(memberForm.user) }}
                </div>
                <div class="nowo-task-field nowo-task-members__add-role">
                    {{ form_label(memberForm.memberRole) }}
                    {{ form_widget(memberForm.memberRole) }}
                    {{ form_errors(memberForm.memberRole) }}
                </div>
                {% for child in memberForm %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(memberForm) }}
        </section>

        <div class="nowo-task-dialog__actions">
            <button type="button" class="btn btn-outline-secondary" data-action="click->nowo-task-board-task-members-modal#close">
                {{ 'task_board.action.close'|trans({}, 'NowoTaskBoardBundle') }}
            </button>
            <button type="submit" form="nowo-task-members-add-{{ task.id }}" class="btn btn-primary nowo-task-members__add-button">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'user-plus'}) }}{{ 'task_board.action.add_member'|trans({}, 'NowoTaskBoardBundle') }}
            </button>
        </div>
    </div>
</dialog>
