{% extends nowo_task_board_layout %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    <link rel="stylesheet" href="{{ asset('css/task-board.css', 'nowo_task_board') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/task-board.js', 'nowo_task_board') }}" defer></script>
{% endblock %}

{% block title %}{{ 'task_board.import.title'|trans({}, 'NowoTaskBoardBundle') }} — {{ board.name }}{% endblock %}

{% block body %}
    {{ include('@NowoTaskBoardBundle/manage/_page_header.html.twig', {
        pageTitle: 'task_board.import.title'|trans({}, 'NowoTaskBoardBundle'),
        pageSubtitle: 'task_board.import.subtitle'|trans({}, 'NowoTaskBoardBundle'),
        breadcrumbRoute: nowo_task_board_route('board'),
        breadcrumbRouteParams: {boardId: board.id},
        breadcrumbParams: {boardId: board.id},
        breadcrumbLabel: board.name,
        headerActions: [
            {href: path(nowo_task_board_route('board'), {boardId: board.id}), icon: 'arrow-left', label: 'task_board.view.back_board'|trans({}, 'NowoTaskBoardBundle'), class: 'btn-outline-secondary'},
        ],
        dashboardRoute: dashboardRoute|default(null),
    }) }}

    {{ include('@NowoTaskBoardBundle/manage/_flashes.html.twig') }}

    <div class="row row-cards">
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">{{ 'task_board.import.form.title'|trans({}, 'NowoTaskBoardBundle') }}</h2>
                </div>
                <div class="card-body">
                    {{ form_start(importForm, {
                        action: path(nowo_task_board_route('board_import'), {boardId: board.id}),
                        method: 'POST',
                        attr: {enctype: 'multipart/form-data'},
                    }) }}
                        {% for child in importForm %}
                            {% if not child.rendered %}
                                {{ form_row(child) }}
                            {% endif %}
                        {% endfor %}
                        <button type="submit" class="btn btn-primary">
                            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'upload'}) }}{{ 'task_board.import.form.submit'|trans({}, 'NowoTaskBoardBundle') }}
                        </button>
                    {{ form_end(importForm) }}
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            {# Since 1.18: what each format imports and how, in a help modal. #}
            <div class="card nowo-task-import-help-card" data-controller="nowo-task-board-dialog">
                <div class="card-header">
                    <h3 class="card-title">{{ 'task_board.import.help.title'|trans({}, 'NowoTaskBoardBundle') }}</h3>
                </div>
                <div class="card-body">
                    <p class="text-secondary small">{{ 'task_board.import.help.intro_board'|trans({}, 'NowoTaskBoardBundle') }}</p>
                    <button type="button" class="btn btn-outline-secondary" data-action="nowo-task-board-dialog#open" data-dialog="import-help">
                        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'help'}) }}{{ 'task_board.import.help.open'|trans({}, 'NowoTaskBoardBundle') }}
                    </button>
                    {{ include('@NowoTaskBoardBundle/manage/_import_help.html.twig', {scope: 'board', helpId: 'board-' ~ board.id}) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
