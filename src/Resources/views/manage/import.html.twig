{% extends nowo_task_board_page_layout() ?? nowo_ui_layout.admin %}
{% set nowo_ui_bundle = 'NowoTaskBoardBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/task-board.css', 'nowo_task_board') }}">
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('js/task-board.js', 'nowo_task_board') }}" defer></script>
{% endblock %}

{% block nowo_ui_document_title %}{{ 'task_board.import.title'|trans({}, 'NowoTaskBoardBundle') }} — {{ board.name }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ nowo_ui_page_header(nowo_task_board_header({
        title: 'task_board.import.title'|trans({}, 'NowoTaskBoardBundle'),
        intro: 'task_board.import.subtitle'|trans({}, 'NowoTaskBoardBundle'),
        crumb: {href: path(nowo_task_board_route('board'), {boardId: board.id}), label: (board.icon ? board.icon ~ ' ' : '') ~ board.name},
        actions: [
            {href: path(nowo_task_board_route('board'), {boardId: board.id}), icon: 'arrow-left', label: 'task_board.view.back_board'|trans({}, 'NowoTaskBoardBundle')},
        ],
        back: dashboardRoute|default(null) ? path(dashboardRoute) : null,
    })) }}
{% endblock %}

{% block nowo_ui_content %}

    <div class="nowo-task-grid">
        <div class="nowo-task-grid__cell nowo-task-grid__main">
            <div class="{{ nowo_ui_class('card', 'NowoTaskBoardBundle') }}">
                <div class="{{ nowo_ui_class('card_header', 'NowoTaskBoardBundle') }}">
                    <h2 class="{{ nowo_ui_class('card_title', 'NowoTaskBoardBundle') }}">{{ 'task_board.import.form.title'|trans({}, 'NowoTaskBoardBundle') }}</h2>
                </div>
                <div class="{{ nowo_ui_class('card_body', 'NowoTaskBoardBundle') }}">
                    {{ form_start(importForm, {
                        action: path(nowo_task_board_route('board_import'), {boardId: board.id}),
                        method: 'POST',
                        attr: {enctype: 'multipart/form-data'},
                    }) }}
                        {{ form_row(importForm.source) }}
                        {# Since 1.22.1: the host's help under the source select — override this block (templates.import extending this page), or set help_link / the Twig global nowo_task_board_import_help_link. #}
                        {% block import_help %}{% endblock %}
                        {{ include('@NowoTaskBoardBundle/manage/_import_help_link.html.twig', {link: help_link|default(nowo_task_board_import_help_link|default(nowo_task_board_configured_help_link())), source: importForm.source.vars.value|default('')}) }}
                        {% for child in importForm %}
                            {% if not child.rendered %}
                                {{ form_row(child) }}
                            {% endif %}
                        {% endfor %}
                        <button type="submit" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}">
                            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'upload'}) }}{{ 'task_board.import.form.submit'|trans({}, 'NowoTaskBoardBundle') }}
                        </button>
                    {{ form_end(importForm) }}
                </div>
            </div>
        </div>
        <div class="nowo-task-grid__cell nowo-task-grid__aside">
            {# Since 1.18: what each format imports and how, in a help modal. #}
            <div class="{{ nowo_ui_class('card', 'NowoTaskBoardBundle') }} nowo-task-import-help-card">
                <div class="{{ nowo_ui_class('card_header', 'NowoTaskBoardBundle') }}">
                    <h3 class="{{ nowo_ui_class('card_title', 'NowoTaskBoardBundle') }}">{{ 'task_board.import.help.title'|trans({}, 'NowoTaskBoardBundle') }}</h3>
                </div>
                <div class="{{ nowo_ui_class('card_body', 'NowoTaskBoardBundle') }}">
                    <p class="{{ nowo_ui_class('muted', 'NowoTaskBoardBundle') }} nowo-task-small">{{ 'task_board.import.help.intro_board'|trans({}, 'NowoTaskBoardBundle') }}</p>
                    <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-nowo-ui-dialog-open="nowo-task-import-help-board-{{ board.id }}">
                        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'help'}) }}{{ 'task_board.import.help.open'|trans({}, 'NowoTaskBoardBundle') }}
                    </button>
                    {{ include('@NowoTaskBoardBundle/manage/_import_help.html.twig', {scope: 'board', helpId: 'board-' ~ board.id}) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
