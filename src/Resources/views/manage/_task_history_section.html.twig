{% import '@NowoTaskBoardBundle/manage/_task_member_label.html.twig' as memberUi %}

{#
    Since 1.12: the activity stream (who did what, when) closing the task detail. Since 1.16 the comments are
    interleaved with the history in time order, a "Comments / All activity" toggle (ClickUp-like) shows only the
    comments, and the comment box with @mentions closes the stream.
#}
{% set _comments = comments|default([]) %}
{% set _stream = task.changeHistory|map(e => {kind: 'history', at: e.createdAt, entry: e})|merge(_comments|map(c => {kind: 'comment', at: c.createdAt, entry: c}))|sort((a, b) => a.at <=> b.at) %}
<details class="nowo-task-section nowo-task-detail__relation nowo-task-detail__history" open data-controller="nowo-task-board-activity-filter">
    <summary class="nowo-task-section__header nowo-task-detail__relation-summary" data-controller="disclosure-icon">
        {{ include('@NowoTaskBoardBundle/manage/_disclosure.html.twig') }}
        <span class="nowo-task-section__title">{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'history'}) }}{{ 'task_board.task.history'|trans({}, 'NowoTaskBoardBundle') }}</span>
        {% if _comments|filter(c => not c.deleted)|length > 0 %}<span class="nowo-task-section__count" title="{{ 'task_board.comment.count'|trans({}, 'NowoTaskBoardBundle') }}">{{ _comments|filter(c => not c.deleted)|length }}</span>{% endif %}
    </summary>
    {% if commentForm is defined and (commentForm or _comments is not empty) %}
        <div class="nowo-task-activity__filter" role="group" aria-label="{{ 'task_board.comment.filter'|trans({}, 'NowoTaskBoardBundle') }}">
            <button type="button" class="nowo-task-activity__filter-btn" aria-pressed="true" data-filter="all" data-action="nowo-task-board-activity-filter#show" data-nowo-task-board-activity-filter-target="button">{{ 'task_board.comment.filter_all'|trans({}, 'NowoTaskBoardBundle') }}</button>
            <button type="button" class="nowo-task-activity__filter-btn" aria-pressed="false" data-filter="comments" data-action="nowo-task-board-activity-filter#show" data-nowo-task-board-activity-filter-target="button">{{ 'task_board.comment.filter_comments'|trans({}, 'NowoTaskBoardBundle') }}</button>
        </div>
    {% endif %}
    <ol class="nowo-task-activity" data-nowo-task-board-activity-filter-target="list">
        {% for item in _stream %}
            {% if item.kind == 'comment' %}
                {{ include('@NowoTaskBoardBundle/manage/_task_comment.html.twig', {comment: item.entry}) }}
            {% else %}
            {% set entry = item.entry %}
            {% set changeKey = 'task_board.history.type.' ~ entry.changeType.value %}
            <li class="nowo-task-activity__item nowo-task-detail__history-item">
                    {% if entry.user %}{{ include('@NowoTaskBoardBundle/manage/_task_member_avatar.html.twig', {user: entry.user, class: 'nowo-task-detail__history-avatar', size: 32, labelled: false}, with_context: false) }}{% endif %}
                    <div class="nowo-task-activity__body">
                        <div class="nowo-task-detail__history-summary">
                            <strong>{% if entry.user %}{{ memberUi.member_label(entry.user, true) }}{% else %}{{ entry.userName ?: 'task_board.history.former_user'|trans({}, 'NowoTaskBoardBundle') }}{% endif %}</strong>
                            <span class="nowo-task-activity__action">
                                {{ changeKey|trans({}, 'NowoTaskBoardBundle') }}
                            {# Since 2.3.0 (spec 216): why, through history.cause_labeler; nothing without one. #}{% set _cause = nowo_task_board_change_cause(entry) %}{% if _cause is not null %}<span class="nowo-task-activity__cause" data-testid="nowo-task-history-cause">({{ _cause }})</span>{% endif %}{# Since 2.18.0 (Beacon spec 234): where the write came from and the host's label of its actor, escaped; nothing without a provenance provider. #}{% if entry.channel or entry.actorLabel %} <span class="nowo-task-activity__via" data-testid="nowo-task-history-via">{% if entry.channel %}{{ ('task_board.history.channel.' ~ entry.channel.value)|trans({}, 'NowoTaskBoardBundle') }}{% endif %}{% if entry.channel and entry.actorLabel %} · {% endif %}{{ entry.actorLabel }}</span>{% endif %}</span>
                        </div>
                        {% if entry.oldValue is not null or entry.newValue is not null %}
                            <div class="nowo-task-detail__history-values nowo-task-activity__values">
                                {% if entry.changeType.value == 'priority' %}
                                    {% if entry.oldValue %}
                                        <span class="nowo-task-activity__old">{{ ('task_board.priority.' ~ entry.oldValue)|trans({}, 'NowoTaskBoardBundle') }}</span>
                                    {% endif %}
                                    {% if entry.oldValue and entry.newValue %}{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'arrow-right'}) }}{% endif %}
                                    {% if entry.newValue %}
                                        <span>{{ ('task_board.priority.' ~ entry.newValue)|trans({}, 'NowoTaskBoardBundle') }}</span>
                                    {% endif %}
                                {% elseif entry.changeType.value == 'completed' %}
                                    {% if entry.oldValue == 'true' %}
                                        {{ 'task_board.history.completed_yes'|trans({}, 'NowoTaskBoardBundle') }}
                                    {% else %}
                                        {{ 'task_board.history.completed_no'|trans({}, 'NowoTaskBoardBundle') }}
                                    {% endif %}
                                    {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'arrow-right'}) }}
                                    {% if entry.newValue == 'true' %}
                                        {{ 'task_board.history.completed_yes'|trans({}, 'NowoTaskBoardBundle') }}
                                    {% else %}
                                        {{ 'task_board.history.completed_no'|trans({}, 'NowoTaskBoardBundle') }}
                                    {% endif %}
                                {% elseif entry.changeType.value == 'tags' %}
                                    {% set oldTags = entry.oldValue|nowo_task_board_tag_list %}
                                    {% set newTags = entry.newValue|nowo_task_board_tag_list %}
                                    {% if oldTags|length > 0 %}
                                        <span class="nowo-task-activity__old">{{ oldTags|join(', ') }}</span>
                                    {% endif %}
                                    {% if oldTags|length > 0 and newTags|length > 0 %}{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'arrow-right'}) }}{% endif %}
                                    {% if newTags|length > 0 %}
                                        <span>{{ newTags|join(', ') }}</span>
                                    {% endif %}
                                {% elseif entry.changeType.value == 'color' %}
                                    {# Since 1.14: the task colour, as swatches with their hex value. #}
                                    {% if entry.oldValue %}
                                        <span class="nowo-task-activity__old"><span class="nowo-task-activity__swatch" data-nowo-task-vars="{{ {'--nowo-task-swatch': entry.oldValue}|json_encode }}" aria-hidden="true"></span>{{ entry.oldValue }}</span>
                                    {% endif %}
                                    {% if entry.oldValue and entry.newValue %}{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'arrow-right'}) }}{% endif %}
                                    {% if entry.newValue %}
                                        <span><span class="nowo-task-activity__swatch" data-nowo-task-vars="{{ {'--nowo-task-swatch': entry.newValue}|json_encode }}" aria-hidden="true"></span>{{ entry.newValue }}</span>
                                    {% else %}
                                        <span>{{ 'task_board.form.task.no_color'|trans({}, 'NowoTaskBoardBundle') }}</span>
                                    {% endif %}
                                {% elseif entry.changeType.value == 'sync_person_reassociated' %}
                                    {# Since 1.25: person: / user: tokens, rendered now (an anonymised person shows anonymised). #}
                                    {% if entry.oldValue %}
                                        <span class="nowo-task-activity__old">{{ task_board_sync_token(entry.oldValue) }}</span>
                                    {% endif %}
                                    {% if entry.oldValue and entry.newValue %}{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'arrow-right'}) }}{% endif %}
                                    {% if entry.newValue %}
                                        <span>{{ task_board_sync_token(entry.newValue) }}</span>
                                    {% endif %}
                                {% elseif entry.changeType.value in ['member_added', 'member_removed'] %}
                                    {% if entry.oldValue %}
                                        <span>{{ entry.oldValue }}</span>
                                    {% endif %}
                                    {% if entry.newValue %}
                                        <span>{{ entry.newValue }}</span>
                                    {% endif %}
                                    {% if entry.context %}
                                        <span class="{{ nowo_ui_class('badge_success', 'NowoTaskBoardBundle') }} nowo-task-badge">{{ ('task_board.member.' ~ entry.context|split(' ')|first)|trans({}, 'NowoTaskBoardBundle') }}</span>
                                    {% endif %}
                                {% elseif entry.changeType.value in ['dependency_added', 'dependency_removed'] %}
                                    {# Since 1.15: the relation and the other task. #}
                                    {% if entry.context %}
                                        <span class="nowo-task-badge nowo-task-dependencies__relation">{{ ('task_board.dependency.relation.' ~ entry.context)|trans({}, 'NowoTaskBoardBundle') }}</span>
                                    {% endif %}
                                    <span class="{{ entry.changeType.value == 'dependency_removed' ? 'nowo-task-activity__old' : '' }}">{{ entry.newValue ?? entry.oldValue }}</span>
                                {% elseif entry.changeType.value in ['time_logged', 'time_removed'] %}
                                    {# Since 1.15: the minutes and the day of a manual time entry. #}
                                    <span class="{{ entry.changeType.value == 'time_removed' ? 'nowo-task-activity__old' : '' }}">{{ ((entry.newValue ?? entry.oldValue) + 0)|nowo_task_board_duration }}</span>
                                    {% if entry.context %}<time datetime="{{ entry.context }}">{{ entry.context }}</time>{% endif %}
                                {% elseif entry.changeType.value == 'time_billable' %}
                                    {# Since 2.12.0: the billable flag of a manual entry (unset, yes, no) and its day. #}
                                    <span class="nowo-task-activity__old">{{ (entry.oldValue == 'true' ? 'task_board.time.billable_yes' : (entry.oldValue == 'false' ? 'task_board.time.billable_no' : 'task_board.time.billable_unset'))|trans({}, 'NowoTaskBoardBundle') }}</span>
                                    {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'arrow-right'}) }}
                                    <span>{{ (entry.newValue == 'true' ? 'task_board.time.billable_yes' : (entry.newValue == 'false' ? 'task_board.time.billable_no' : 'task_board.time.billable_unset'))|trans({}, 'NowoTaskBoardBundle') }}</span>
                                    {% if entry.context %}<time datetime="{{ entry.context }}">{{ entry.context }}</time>{% endif %}
                                {% elseif entry.changeType.value in ['link_added', 'link_updated', 'link_removed'] %}
                                    {% if entry.oldValue %}
                                        <span class="nowo-task-activity__old">{{ entry.oldValue }}</span>
                                    {% endif %}
                                    {% if entry.oldValue and entry.newValue %}{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'arrow-right'}) }}{% endif %}
                                    {% if entry.newValue %}
                                        <span>{{ entry.newValue }}</span>
                                    {% elseif entry.oldValue and entry.changeType.value == 'link_removed' %}
                                        <span>{{ entry.oldValue }}</span>
                                    {% endif %}
                                {% else %}
                                    {% if entry.oldValue %}
                                        <span class="nowo-task-activity__old">{{ entry.oldValue }}</span>
                                    {% endif %}
                                    {% if entry.oldValue and entry.newValue %}{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'arrow-right'}) }}{% endif %}
                                    {% if entry.newValue %}
                                        <span>{{ entry.newValue }}</span>
                                    {% endif %}
                                {% endif %}
                            </div>
                        {% endif %}
                        <time class="nowo-task-activity__time" datetime="{{ entry.createdAt|date('c') }}">{{ entry.createdAt|date('Y-m-d H:i') }}</time>
                    </div>
            </li>
            {% endif %}
        {% else %}
            <li class="nowo-task-activity__item nowo-task-detail__empty">{{ 'task_board.task.no_history'|trans({}, 'NowoTaskBoardBundle') }}</li>
        {% endfor %}
    </ol>
    {% if commentDeleteForm is defined and commentDeleteForm %}
        {# REQ-TWIG-005: CSRF-only form; each delete button sets its own formaction. #}
        {{ form_start(commentDeleteForm, {action: '#', attr: {id: 'nowo-task-comment-delete-form', hidden: 'hidden'}}) }}
            {% for child in commentDeleteForm %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        {{ form_end(commentDeleteForm) }}
    {% endif %}
    {% if commentForm|default(null) %}
        {{ include('@NowoTaskBoardBundle/manage/_task_comment_box.html.twig', {form: commentForm, submitLabel: 'task_board.comment.add'}) }}
    {% endif %}
</details>
