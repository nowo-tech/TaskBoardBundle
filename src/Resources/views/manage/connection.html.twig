{% extends '@NowoUiKitBundle/page/show.html.twig' %}
{#
    Since 1.23: the provider connection of a board. Unlinked: provider, stored connection, the container browser and
    the import options. Linked: status, Refresh, progress, people (since 1.27.0), history, Unlink. Override with
    templates.connection.
#}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/task-board.css', 'nowo_task_board') }}">
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('js/task-board.js', 'nowo_task_board') }}" defer></script>
{% endblock %}

{% block nowo_ui_show_sections %}

    {% if connection %}
        {% block nowo_task_board_connection_linked %}
            <div class="nowo-task-grid nowo-task-sync" data-testid="nowo-task-sync-linked">
                <div class="nowo-task-grid__cell nowo-task-grid__main">
                    <section class="{{ nowo_ui_class('card', 'NowoTaskBoardBundle') }}" aria-labelledby="nowo-task-sync-status-title">
                        <div class="{{ nowo_ui_class('card_header', 'NowoTaskBoardBundle') }}">
                            <h2 class="{{ nowo_ui_class('card_title', 'NowoTaskBoardBundle') }}" id="nowo-task-sync-status-title">
                                {{ (provider ? provider.labelKey : 'task_board.sync.provider.unknown')|trans({}, 'NowoTaskBoardBundle') }} · {{ connection.containerLabel }}
                            </h2>
                        </div>
                        <div class="{{ nowo_ui_class('card_body', 'NowoTaskBoardBundle') }}">
                            {% if connection.sourceDescription %}
                                <p class="{{ nowo_ui_class('muted', 'NowoTaskBoardBundle') }} nowo-task-small nowo-task-mb-2" data-testid="nowo-task-sync-source-description"><strong>{{ 'task_board.sync.page.source_description'|trans({'%provider%': (provider ? provider.labelKey : 'task_board.sync.provider.unknown')|trans({}, 'NowoTaskBoardBundle')}, 'NowoTaskBoardBundle') }}:</strong> {{ connection.sourceDescription }}</p>
                            {% endif %}
                            {% if connection.containerPath is not empty %}
                                <p class="{{ nowo_ui_class('muted', 'NowoTaskBoardBundle') }} nowo-task-small nowo-task-mb-2">{{ connection.containerPath|join(' › ') }}</p>
                            {% endif %}
                            <p class="nowo-task-mb-3">
                                {% if connection.lastSuccessAt %}
                                    {{ 'task_board.sync.status.last_sync'|trans({'%date%': connection.lastSuccessAt|date('Y-m-d H:i')}, 'NowoTaskBoardBundle') }}
                                {% else %}
                                    {{ 'task_board.sync.status.never'|trans({}, 'NowoTaskBoardBundle') }}
                                {% endif %}
                            </p>

                            {% if massArchiveForm %}
                                {{ include('@NowoTaskBoardBundle/manage/_connection_mass_archive.html.twig') }}
                            {% endif %}

                            {% if activeRun %}
                                {{ include(templates.connection_progress) }}
                            {% elseif latestSummary %}
                                <p class="nowo-task-sync__summary" data-testid="nowo-task-sync-summary">{{ latestSummary }}</p>
                            {% endif %}

                            {# Since 1.27.0 (TB-SYNC-2): mapped / unmapped people and the People page. #}
                            {{ include(templates.connection_people_summary, {peopleSummary: peopleSummary|default(null)}) }}

                            {# Since 1.27.0 (TB-SYNC-3): what the latest run imported, field by field. #}
                            {{ include('@NowoTaskBoardBundle/manage/_connection_completeness.html.twig', {completeness: completeness|default([]), provider: provider}) }}

                            <div class="nowo-task-flex nowo-task-wrap nowo-task-gap align-items-end">
                                {{ form_start(refreshForm, {action: path(nowo_task_board_route('board_connection_refresh'), {boardId: board.id}), method: 'POST', attr: {class: 'nowo-task-sync__refresh nowo-task-flex nowo-task-wrap nowo-task-gap nowo-task-center'}}) }}
                                    {% for child in refreshForm %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
                                    <button type="submit" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}" data-testid="nowo-task-sync-refresh"{% if activeRun %} disabled aria-disabled="true"{% endif %}>
                                        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'refresh'}) }}{{ 'task_board.sync.refresh.action'|trans({'%provider%': (provider ? provider.labelKey : 'task_board.sync.provider.unknown')|trans({}, 'NowoTaskBoardBundle')}, 'NowoTaskBoardBundle') }}
                                    </button>
                                {{ form_end(refreshForm) }}
                                {{ include('@NowoTaskBoardBundle/manage/_connection_unlink_dialog.html.twig') }}
                            </div>
                        </div>
                    </section>
                </div>
                <div class="nowo-task-grid__cell">
                    {{ include(templates.connection_history) }}
                </div>
            </div>
        {% endblock %}
    {% else %}
        {% block nowo_task_board_connection_connect %}
            <div class="nowo-task-grid nowo-task-sync" data-testid="nowo-task-sync-connect">
                <div class="nowo-task-grid__cell nowo-task-grid__main">
                    <section class="{{ nowo_ui_class('card', 'NowoTaskBoardBundle') }}" aria-labelledby="nowo-task-sync-connect-title">
                        <div class="{{ nowo_ui_class('card_header', 'NowoTaskBoardBundle') }}">
                            <h2 class="{{ nowo_ui_class('card_title', 'NowoTaskBoardBundle') }}" id="nowo-task-sync-connect-title">{{ 'task_board.sync.connect.title'|trans({}, 'NowoTaskBoardBundle') }}</h2>
                        </div>
                        <div class="{{ nowo_ui_class('card_body', 'NowoTaskBoardBundle') }}">
                            {{ include('@NowoTaskBoardBundle/manage/_connection_provider_picker.html.twig') }}

                            {% if provider and choice and linkForm %}
                                {{ form_start(linkForm, {method: 'POST', attr: {class: 'nowo-task-sync__link', 'data-controller': 'nowo-task-board-container-browser', 'data-nowo-task-board-container-browser-url-value': path(nowo_task_board_route('board_connection_containers'), {boardId: board.id}), 'data-nowo-task-board-container-browser-loading-value': 'task_board.sync.browser.loading'|trans({}, 'NowoTaskBoardBundle'), 'data-nowo-task-board-container-browser-loaded-value': 'task_board.sync.browser.loaded'|trans({}, 'NowoTaskBoardBundle'), 'data-nowo-task-board-container-browser-failed-value': 'task_board.sync.browser.failed'|trans({}, 'NowoTaskBoardBundle')}}) }}
                                    {{ form_widget(linkForm.provider) }}
                                    {{ form_widget(linkForm.connection) }}
                                    {# The flat CSRF token of the container browser (its script posts it; so do the no-script buttons). #}
                                    {{ form_widget(containersForm._token) }}
                                    {% do linkForm.container.setRendered() %}
                                    <fieldset class="nowo-task-tree nowo-task-mb-3" aria-describedby="nowo-task-tree-help">
                                        <legend class="{{ nowo_ui_class('form_label', 'NowoTaskBoardBundle') }}">{{ 'task_board.sync.browser.legend'|trans({}, 'NowoTaskBoardBundle') }}</legend>
                                        <p class="{{ nowo_ui_class('muted', 'NowoTaskBoardBundle') }} nowo-task-small" id="nowo-task-tree-help">{{ 'task_board.sync.browser.help'|trans({}, 'NowoTaskBoardBundle') }}</p>
                                        <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-nowo-task-board-container-browser-target="status"></p>
                                        {% if treeError %}
                                            {{ include('@NowoTaskBoardBundle/manage/_connection_tree_error.html.twig', {error: treeError}) }}
                                        {% elseif tree is not null %}
                                            {{ include(templates.connection_containers, {level: tree[''], levelForm: levelForms[''], parent: '', depth: 1}) }}
                                        {% endif %}
                                        {{ form_errors(linkForm.container) }}
                                    </fieldset>
                                    <fieldset class="nowo-task-mb-3">
                                        <legend class="{{ nowo_ui_class('form_label', 'NowoTaskBoardBundle') }}">{{ 'task_board.sync.option.legend'|trans({}, 'NowoTaskBoardBundle') }}</legend>
                                        {% for child in linkForm %}{% if not child.rendered and child.vars.name != '_token' %}{{ form_row(child) }}{% endif %}{% endfor %}
                                    </fieldset>
                                    <button type="submit" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}" data-testid="nowo-task-sync-import">
                                        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'download'}) }}{{ 'task_board.sync.connect.submit'|trans({}, 'NowoTaskBoardBundle') }}
                                    </button>
                                {{ form_end(linkForm) }}
                            {% endif %}
                        </div>
                    </section>
                </div>
            </div>
        {% endblock %}
    {% endif %}
{% endblock %}
