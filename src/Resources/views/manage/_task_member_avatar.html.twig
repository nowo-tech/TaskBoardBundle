{#-
    Since 1.23: one member chip, overridable by a host. Since 2.0.0 it wraps UiKit's `avatar` partial: the initials, with the
    member's picture over them when the host's TaskMemberAvatarResolverInterface gives a URL that passes the kit's avatar URL
    policy (nowo_task_board_member_avatar_url). A failed picture falls back to the initials (js/nowo-ui-avatar.js).
    Included with with_context = false. Variables: user (user_class or null), class (the chip class of that place), size (24
    or 32), labelled (true when no name is printed next to it: the chip is named; otherwise it is decorative).
-#}
{%- import '@NowoTaskBoardBundle/manage/_task_member_label.html.twig' as memberUi -%}
{#- The label is the macro's own escaped output; the URL is cast to a string, never printed as Markup (audit DZ-L2). -#}
{%- set _label = memberUi.member_label(user)|trim -%}
{%- set _url = nowo_task_board_member_avatar_url(user) -%}
<span class="{{ class }}"{% if labelled|default(false) %} title="{{ _label }}"{% endif %}>
    {{- include('@NowoUiKitBundle/partials/_avatar.html.twig', {
        name: _label,
        initials: _label|slice(0, 1)|upper,
        src: _url is null ? null : _url ~ '',
        decorative: not labelled|default(false),
        size: size|default(32) == 24 ? 'sm' : null,
    }, with_context: false) -}}
</span>
