{#
    Since 2.1.0 (spec 214, FR-019): the days with tasks, in order. Variables: those of calendar.html.twig.
#}
{% for day in calendar.days %}
    <section class="nowo-task-cal__list-day{{ day.today ? ' is-today' : '' }}" id="nowo-task-cal-day-{{ day.date }}" data-date="{{ day.date }}">
        <h3 class="nowo-task-cal__list-date">
            {{ day.date }}
            {% if canEditBoard %}
                <button type="button" class="nowo-task-cal__add" data-testid="nowo-task-cal-add" data-action="nowo-task-board-add-task-modal#open" data-due-date="{{ day.date }}" data-column-name="{{ day.date }}" aria-label="{{ 'task_board.calendar.add_on_day'|trans({'%date%': day.date}, 'NowoTaskBoardBundle') }}" title="{{ 'task_board.calendar.add_on_day'|trans({'%date%': day.date}, 'NowoTaskBoardBundle') }}">{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'plus'}) }}</button>
            {% endif %}
        </h3>
        <ul class="nowo-task-plain-list">
            {% for entry in day.entries %}
                {{ include('@NowoTaskBoardBundle/manage/_calendar_row.html.twig') }}
            {% endfor %}
        </ul>
    </section>
{% else %}
    <p class="nowo-task-cal__empty">{{ 'task_board.calendar.empty'|trans({}, 'NowoTaskBoardBundle') }}</p>
{% endfor %}
