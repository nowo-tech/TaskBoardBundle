{#
    Since 1.30.0 (spec 211): a Markdown board description, through the host's text renderer, folded after three lines with
    Show more. Since 2.0.0 UiKit's `show_more` partial; the page loads js/nowo-ui-show-more.js. Without it the whole text shows.
#}
{{ include(nowo_ui_partial('show_more', 'NowoTaskBoardBundle'), {
    id: 'nowo-task-board-description-' ~ board.id,
    content: nowo_task_board_description(board),
    lines: 3,
    labels: {more: 'task_board.board.show_more'|trans({}, 'NowoTaskBoardBundle'), less: 'task_board.board.show_less'|trans({}, 'NowoTaskBoardBundle')},
    attr: {class: 'nowo-task-board-description nowo-task-text', 'data-testid': 'nowo-task-board-description'},
    bundle: 'NowoTaskBoardBundle',
}, false) }}
