{#
    Blocks of the task page and of the task panel fragment (since 1.11, imported with {% use %} by task.html.twig and
    task_panel.html.twig, so a host overriding nowo_task_panel / nowo_task_toolbar / nowo_task_subtasks /
    nowo_task_relations in a template extending task.html.twig keeps working).
    Variables: those of the task page; panel (bool) and panelTargetPath in the panel; taskRouteExtra: query added to
    every write route (the panel's _target_path).
#}
{% block nowo_task_body %}
    {{ include('@NowoTaskBoardBundle/manage/_flashes.html.twig') }}

    {% set subtaskTotal = subtaskTotal|default(task.subtasks|length) %}
    {% set subtaskDone = subtaskDone|default(0) %}

    {# REQ-TWIG-005: CSRF-only form; the status / column buttons post into it through form="nowo-task-advance-form". #}
    {{ form_start(advanceForm, {attr: {id: 'nowo-task-advance-form', hidden: 'hidden', 'aria-hidden': 'true'}}) }}
        {% for child in advanceForm %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(advanceForm) }}

    {% block nowo_task_panel %}
    {% import '@NowoTaskBoardBundle/manage/_task_member_label.html.twig' as memberUi %}
    {% import '@NowoTaskBoardBundle/manage/_task_priority_tag.html.twig' as priorityUi %}
    {#
        Since 1.12 (ClickUp-like detail, host-neutral layout): the toolbar, a head with the status pill, the priority and
        the title edited in place, then one grid of attributes (label → value), then the description. Layout classes are
        the bundle's own (nowo-task-detail__*), coloured by the --nowo-task-* tokens.
    #}
    <div class="nowo-task-detail nowo-task-panel" data-controller="nowo-task-board-task-members-modal nowo-task-board-task-priority-modal">
        {% block nowo_task_toolbar %}
        <div class="nowo-task-detail__toolbar">
            <nav class="nowo-task-detail__trail" aria-label="{{ 'task_board.index.title'|trans({}, 'NowoTaskBoardBundle') }}">
                <a href="{{ path(nowo_task_board_route('index')) }}">{{ 'task_board.index.title'|trans({}, 'NowoTaskBoardBundle') }}</a>
                <span aria-hidden="true">/</span>
                <a href="{{ path(nowo_task_board_route('board'), {boardId: task.board.id}) }}">{{ task.board.name }}</a>
            </nav>
            <div class="nowo-task-detail__actions">
                {% if panel|default(false) %}
                {# Since 1.11 (task panel): the full task page stays one click away. #}
                <a href="{{ path(nowo_task_board_route('task'), {taskId: task.id}) }}" class="btn btn-outline-secondary btn-sm nowo-task-panel__open-page">
                    {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'external-link'}) }}{{ 'task_board.task.open_page'|trans({}, 'NowoTaskBoardBundle') }}
                </a>
                {% else %}
                <a href="{{ path(nowo_task_board_route('board'), {boardId: task.board.id}) }}" class="btn btn-outline-secondary btn-sm">
                    {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'layout-kanban'}) }}{{ 'task_board.view.back_board'|trans({}, 'NowoTaskBoardBundle') }}
                </a>
                {% endif %}
                {% if (canEditTask ?? true) %}
                <button type="submit" form="nowo-task-edit-form" class="btn btn-primary btn-sm">
                    {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'device-floppy'}) }}{{ 'task_board.action.save'|trans({}, 'NowoTaskBoardBundle') }}
                </button>
                {% endif %}
            </div>
        </div>
        {% endblock %}

        {% block nowo_task_navigation %}
        {# Since 1.20: previous / next task (board or list order, subtasks). #}
        {{ include('@NowoTaskBoardBundle/manage/_task_navigation.html.twig') }}
        {% endblock %}

        <div class="nowo-task-detail__body">
            {{ form_start(taskForm, {action: path(nowo_task_board_route('task'), {taskId: task.id}|merge(taskRouteExtra|default({}))), attr: {id: 'nowo-task-edit-form', class: 'nowo-task-detail__form'}}) }}

            <div class="nowo-task-detail__head">
                <div class="nowo-task-detail__head-meta">
                    {{ include('@NowoTaskBoardBundle/manage/_task_status_field.html.twig') }}
                    {% if taskForm.columnId is defined %}
                        <div hidden>{{ form_widget(taskForm.columnId, {label: false}) }}</div>
                    {% endif %}
                    {{ priorityUi.priority_tag(task.priority, true) }}
                    <div hidden>{{ form_widget(taskForm.priority, {label: false}) }}</div>
                </div>
                {# Since 1.15: the parent path of a subtask ("Epic › Story › this task"). #}
                {% set _ancestors = nowo_task_board_ancestors(task) %}
                {% if _ancestors is not empty %}
                    <nav class="nowo-task-detail__parents" aria-label="{{ 'task_board.task.parents'|trans({}, 'NowoTaskBoardBundle') }}">
                        <ol class="nowo-task-detail__parents-list">
                            {% for ancestor in _ancestors %}
                                <li><a href="{{ path(nowo_task_board_route('task'), {taskId: ancestor.id}) }}"{% if panel|default(false) %} data-task-panel-url="{{ path(nowo_task_board_route('task_panel'), {taskId: ancestor.id}|merge(taskRouteExtra|default({}))) }}"{% endif %}>{{ ancestor.title }}</a></li>
                            {% endfor %}
                            <li aria-current="page">{{ task.title }}</li>
                        </ol>
                    </nav>
                {% endif %}
                <div class="nowo-task-detail__title">
                    {{ form_widget(taskForm.title, {
                        label: false,
                        attr: {
                            maxlength: 255,
                            class: 'form-control nowo-task-detail__title-input',
                            placeholder: 'task_board.form.task.title'|trans({}, 'NowoTaskBoardBundle'),
                        },
                    }) }}
                    {{ form_errors(taskForm.title) }}
                </div>
            </div>

            <dl class="nowo-task-detail__attrs nowo-task-detail__meta">
                <div class="nowo-task-detail__field nowo-task-detail__attr">
                    <dt class="nowo-task-detail__field-label">
                        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'users'}) }}
                        <span>{{ 'task_board.task.people'|trans({}, 'NowoTaskBoardBundle') }}</span>
                    </dt>
                    <dd class="nowo-task-detail__field-value">
                        <button
                            type="button"
                            class="nowo-task-detail__people"
                            data-action="click->nowo-task-board-task-members-modal#open"
                            title="{{ 'task_board.task.manage_people'|trans({}, 'NowoTaskBoardBundle') }}"
                        >
                            {% for member in task.members %}
                                <span class="nowo-task-detail__member-chip" title="{{ ('task_board.member.' ~ member.memberRole.value)|trans({}, 'NowoTaskBoardBundle') }}">
                                    <span class="nowo-task-detail__member-chip-avatar" aria-hidden="true">{{ memberUi.member_label(member.user)|trim|slice(0, 1)|upper }}</span>
                                    <span class="nowo-task-detail__member-chip-name">{{ memberUi.member_label(member.user) }}</span>
                                </span>
                            {% else %}
                                <span class="nowo-task-detail__empty">{{ 'task_board.task.no_members'|trans({}, 'NowoTaskBoardBundle') }}</span>
                            {% endfor %}
                            <span class="nowo-task-detail__field-edit" aria-hidden="true">{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'user-plus'}) }}</span>
                            <span class="nowo-task-sr-only">{{ 'task_board.task.manage_people'|trans({}, 'NowoTaskBoardBundle') }}</span>
                        </button>
                    </dd>
                </div>

                {#
                    Since 1.15 the start date (the Gantt bar starts there); since 1.20 start and due date share one row,
                    side by side (wrapping on a narrow panel), each input with its own small label.
                #}
                <div class="nowo-task-detail__field nowo-task-detail__attr nowo-task-detail__attr--dates">
                    <dt class="nowo-task-detail__field-label">
                        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'calendar'}) }}
                        <span>{{ 'task_board.task.dates'|trans({}, 'NowoTaskBoardBundle') }}</span>
                    </dt>
                    <dd class="nowo-task-detail__field-value nowo-task-detail__dates">
                        {% if taskForm.startAt is defined %}
                            <label class="nowo-task-detail__date">
                                <span class="nowo-task-detail__inline-label">{{ 'task_board.form.task.start'|trans({}, 'NowoTaskBoardBundle') }}</span>
                                {{ form_widget(taskForm.startAt, {label: false, attr: taskForm.startAt.vars.attr|merge({'aria-label': 'task_board.form.task.start'|trans({}, 'NowoTaskBoardBundle')})}) }}
                            </label>
                        {% endif %}
                        <label class="nowo-task-detail__date">
                            <span class="nowo-task-detail__inline-label">{{ 'task_board.form.task.due'|trans({}, 'NowoTaskBoardBundle') }}</span>
                            {{ form_widget(taskForm.dueAt, {label: false, attr: taskForm.dueAt.vars.attr|merge({'aria-label': 'task_board.form.task.due'|trans({}, 'NowoTaskBoardBundle')})}) }}
                        </label>
                        {% if taskForm.startAt is defined %}{{ form_errors(taskForm.startAt) }}{% endif %}
                    </dd>
                </div>

                <div class="nowo-task-detail__field nowo-task-detail__attr">
                    <dt class="nowo-task-detail__field-label">
                        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'clock-play'}) }}
                        <span>{{ 'task_board.task.time'|trans({}, 'NowoTaskBoardBundle') }}</span>
                    </dt>
                    <dd class="nowo-task-detail__field-value nowo-task-detail__time">
                        {% set _deviation = deviation|default(nowo_task_board_deviation(task)) %}
                        <span class="nowo-task-detail__logged" title="{{ 'task_board.time.logged'|trans({}, 'NowoTaskBoardBundle') }}"><strong>{{ task.loggedMinutes|nowo_task_board_duration }}</strong></span>
                        {% if _deviation.hasEstimate %}
                            {#
                                Since 1.15 the deviation beside the time spent; since 1.20 worded as the time left ("24 h left",
                                neutral) or the overrun ("Over by 2 h", danger colour), the signed deviation in the tooltip.
                            #}
                            {% set _over = _deviation.difference > 0 %}
                            <span
                                class="nowo-task-deviation-pill nowo-task-remaining nowo-task-remaining--{{ _over ? 'over' : 'left' }}{{ _over ? ' nowo-task-deviation-pill--over' : '' }}"
                                data-deviation-status="{{ _deviation.status }}"
                                title="{{ ('task_board.time.status.' ~ _deviation.status)|trans({}, 'NowoTaskBoardBundle') }} · {{ _deviation.difference|nowo_task_board_duration(true) }} ({{ _deviation.percent > 0 ? '+' : '' }}{{ _deviation.percent }} %)"
                            >{{ _over
                                ? 'task_board.time.over_by'|trans({'%duration%': _deviation.difference|nowo_task_board_duration}, 'NowoTaskBoardBundle')
                                : 'task_board.time.left'|trans({'%duration%': (0 - _deviation.difference)|nowo_task_board_duration}, 'NowoTaskBoardBundle') }}</span>
                        {% endif %}
                        <span class="nowo-task-detail__estimate">
                            <span class="nowo-task-detail__inline-label">{{ 'task_board.time.estimate'|trans({}, 'NowoTaskBoardBundle') }}</span>
                            {{ form_widget(taskForm.estimatedMinutes, {label: false, attr: taskForm.estimatedMinutes.vars.attr|merge({class: 'form-control form-control-sm nowo-task-detail__inline-input', 'aria-label': 'task_board.time.estimate'|trans({}, 'NowoTaskBoardBundle')})}) }}
                            {{ form_errors(taskForm.estimatedMinutes) }}
                        </span>
                    </dd>
                </div>

                <div class="nowo-task-detail__field nowo-task-detail__attr">
                    <dt class="nowo-task-detail__field-label">
                        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'tags'}) }}
                        <span>{{ 'task_board.form.task.tags'|trans({}, 'NowoTaskBoardBundle') }}</span>
                    </dt>
                    <dd class="nowo-task-detail__field-value">
                        {{ form_widget(taskForm.tags, {label: false, attr: taskForm.tags.vars.attr|merge({'aria-label': 'task_board.form.task.tags'|trans({}, 'NowoTaskBoardBundle')})}) }}
                    </dd>
                </div>

                {# Since 1.14: the task's colour (its Gantt bar and the card's edge), the column dialogs' palette. #}
                {% if taskForm.color is defined %}
                <div class="nowo-task-detail__field nowo-task-detail__attr">
                    <dt class="nowo-task-detail__field-label">
                        {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'palette'}) }}
                        <span>{{ 'task_board.form.task.color'|trans({}, 'NowoTaskBoardBundle') }}</span>
                    </dt>
                    <dd class="nowo-task-detail__field-value">
                        {{ include('@NowoTaskBoardBundle/manage/_colour_picker.html.twig', {
                            field: taskForm.color,
                            custom: taskForm.customColor,
                            showLabel: false,
                            groupLabel: 'task_board.form.task.color'|trans({}, 'NowoTaskBoardBundle'),
                        }) }}
                    </dd>
                </div>
                {% endif %}
            </dl>

            <section class="nowo-task-detail__section nowo-task-detail__description">
                {# Since 1.14.1: the widgets drawn without their label carry an aria-label (axe "label"). #}
                <h3 class="nowo-task-detail__section-title">{{ 'task_board.task.description_section'|trans({}, 'NowoTaskBoardBundle') }}</h3>
                {% set _description_widget %}{{ form_widget(taskForm.description, {label: false, attr: taskForm.description.vars.attr|merge({'aria-label': 'task_board.task.description_section'|trans({}, 'NowoTaskBoardBundle')})}) }}{% endset %}
                {#
                    Since 1.19: a plain-text description (no rich editor) is shown through the text renderer (plain, or the
                    host's Markdown); editors open the field under it. A rich editor keeps showing itself.
                #}
                {% if 'textarea' in taskForm.description.vars.block_prefixes and task.description|default('')|trim is not empty %}
                    <div class="nowo-task-detail__description-view nowo-task-text">{{ nowo_task_board_text(task.description) }}</div>
                    {% if (canEditTask ?? true) %}
                        <details class="nowo-task-detail__description-edit">
                            <summary class="btn btn-sm btn-outline-secondary" data-controller="disclosure-icon">
                                {{ include('@NowoTaskBoardBundle/manage/_disclosure.html.twig') }}{{ 'task_board.task.edit_description'|trans({}, 'NowoTaskBoardBundle') }}
                            </summary>
                            {{ _description_widget }}
                        </details>
                    {% else %}
                        <div hidden>{{ _description_widget }}</div>
                    {% endif %}
                {% else %}
                    {{ _description_widget }}
                {% endif %}
            </section>

            {% for child in taskForm %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}

            {{ form_end(taskForm) }}
        </div>

        {{ include('@NowoTaskBoardBundle/manage/_task_members_modal.html.twig') }}
        {{ include('@NowoTaskBoardBundle/manage/_task_priority_modal.html.twig') }}
    </div>
    {% endblock %}

    {% block nowo_task_subtasks %}
    {# Since 1.12: a checklist with its progress and an inline "Add subtask" (Enter adds). #}
    <section class="nowo-task-detail nowo-task-section nowo-task-detail__subtasks" data-controller="nowo-task-board-subtask-tree">
        {#
            Since 1.20 the header keeps the title, its count, the progress bar and the fold toggle together on the left
            (the toggle is an icon button beside the title, not a far-off button).
        #}
        <header class="nowo-task-section__header nowo-task-detail__section-header nowo-task-subtasks__header">
            <h2 class="nowo-task-section__title">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'subtask'}) }}{{ 'task_board.task.subtasks'|trans({}, 'NowoTaskBoardBundle') }}
                {% if subtaskTotal > 0 %}
                    <span class="nowo-task-section__count">{{ subtaskDone }}/{{ subtaskTotal }}</span>
                {% endif %}
            </h2>
            {% if subtaskTotal > 0 %}
                <progress class="nowo-task-progress nowo-task-subtasks__progress" max="{{ subtaskTotal }}" value="{{ subtaskDone }}" aria-label="{{ 'task_board.task.subtasks_progress'|trans({'%done%': subtaskDone, '%total%': subtaskTotal}, 'NowoTaskBoardBundle') }}">{{ subtaskDone }}/{{ subtaskTotal }}</progress>
                <button type="button" class="btn btn-sm btn-ghost-secondary btn-icon nowo-task-board-subtask-tree__toggle" data-nowo-task-board-subtask-tree-target="toggle" data-action="nowo-task-board-subtask-tree#toggle" aria-expanded="true" title="{{ 'task_board.task.toggle_subtasks'|trans({}, 'NowoTaskBoardBundle') }}">
                    {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'list-tree'}) }}<span class="nowo-task-sr-only">{{ 'task_board.task.toggle_subtasks'|trans({}, 'NowoTaskBoardBundle') }}</span>
                </button>
            {% endif %}
        </header>
        <div class="nowo-task-detail__subtask-list" data-nowo-task-board-subtask-tree-target="list">
            {# Since 1.10: the whole subtree (any depth) through the recursive partial. #}
            {{ include('@NowoTaskBoardBundle/manage/_subtask_tree.html.twig', {
                tasks: taskTree|default(null) ? taskTree.childrenOf(task) : task.subtasks,
                depth: 0,
            }) }}
        </div>
        {# Read-only users (since 1.10) see the tree without the add form. #}
        {% if (canEditTask ?? true) %}
            {{ form_start(subtaskForm, {action: path(nowo_task_board_route('task_subtask'), {taskId: task.id}|merge(taskRouteExtra|default({}))), method: 'POST', attr: {class: 'nowo-task-detail__inline-add nowo-task-inline-add'}}) }}
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'plus', class: 'nowo-task-inline-add__icon'}) }}
                {{ form_widget(subtaskForm.title, {
                    label: false,
                    attr: {
                        maxlength: 255,
                        class: 'form-control nowo-task-inline-add__input',
                        placeholder: 'task_board.task.add_subtask_placeholder'|trans({}, 'NowoTaskBoardBundle'),
                        'aria-label': 'task_board.action.add_subtask'|trans({}, 'NowoTaskBoardBundle'),
                    },
                }) }}
                <button type="submit" class="btn btn-sm btn-outline-primary nowo-task-inline-add__submit">{{ 'task_board.action.add_subtask'|trans({}, 'NowoTaskBoardBundle') }}</button>
                {% for child in subtaskForm %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(subtaskForm) }}
            {# Since 1.18: import a subtask tree (with its Gantt relations) from a file. #}
            {{ include('@NowoTaskBoardBundle/manage/_task_subtask_import.html.twig') }}
        {% endif %}
    </section>
    {% endblock %}

    {% block nowo_task_time %}
    {# Since 1.15: estimate, time spent, the deviation and the manual time entries. #}
    {{ include('@NowoTaskBoardBundle/manage/_task_time_section.html.twig') }}
    {% endblock %}

    {% block nowo_task_relations %}
    <div
        class="nowo-task-detail__relations"
        data-controller="nowo-task-board-task-links-modal"
        data-nowo-task-board-task-links-modal-create-url-value="{{ path(nowo_task_board_route('task_link'), {taskId: task.id}|merge(taskRouteExtra|default({}))) }}"
        data-nowo-task-board-task-links-modal-update-url-value="{{ path(nowo_task_board_route('task_link_update'), {taskId: task.id, linkId: 'LINK_ID'}|merge(taskRouteExtra|default({}))) }}"
        data-nowo-task-board-task-links-modal-remove-url-value="{{ path(nowo_task_board_route('task_link_remove'), {taskId: task.id, linkId: 'LINK_ID'}|merge(taskRouteExtra|default({}))) }}"
        data-nowo-task-board-task-links-modal-add-title-value="{{ 'task_board.task.links_modal_add_title'|trans({}, 'NowoTaskBoardBundle')|e('html_attr') }}"
        data-nowo-task-board-task-links-modal-edit-title-value="{{ 'task_board.task.links_modal_edit_title'|trans({}, 'NowoTaskBoardBundle')|e('html_attr') }}"
    >
        {{ include('@NowoTaskBoardBundle/manage/_task_links_section.html.twig') }}
        {{ include('@NowoTaskBoardBundle/manage/_task_links_modal.html.twig') }}

        {# Since 1.15: dependencies in both directions, added and removed from here. #}
        {{ include('@NowoTaskBoardBundle/manage/_task_dependencies_section.html.twig') }}

        <details class="nowo-task-section nowo-task-detail__relation">
            <summary class="nowo-task-section__header nowo-task-detail__relation-summary" data-controller="disclosure-icon">
                {{ include('@NowoTaskBoardBundle/manage/_disclosure.html.twig') }}
                <span class="nowo-task-section__title">{{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'notes'}) }}{{ 'task_board.task.documentation'|trans({}, 'NowoTaskBoardBundle') }}</span>
            </summary>
            <div class="nowo-task-section__body">
                {% for doc in task.documents %}
                    <article class="nowo-task-detail__doc">
                        <h3 class="nowo-task-detail__doc-title">{{ doc.title }}</h3>
                        <div class="nowo-task-detail__doc-body">{{ doc.content|nl2br }}</div>
                    </article>
                {% else %}
                    <p class="nowo-task-detail__empty">{{ 'task_board.task.no_docs'|trans({}, 'NowoTaskBoardBundle') }}</p>
                {% endfor %}
            </div>
        </details>

        {# Since 1.12 the activity (history) closes the detail, like a ClickUp activity stream. #}
        {{ include('@NowoTaskBoardBundle/manage/_task_history_section.html.twig') }}
    </div>
    {% endblock %}
{% endblock %}
