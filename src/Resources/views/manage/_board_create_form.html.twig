{#
    Since 1.24: the New board form, one partial for the index dialog, its <noscript> copy and the 422 answer of an
    invalid create in a host dialog (board.create_dialog_header). Values and errors of an invalid submission are kept.
    Variables: form (the TaskBoardFormType view, posted to the board_create route of the current tenant);
    in_dialog (default false: adds Cancel, which closes the surrounding kit dialog);
    id_prefix (default '': prefixes the field ids and the form id, so a second copy of the form on the page keeps its
    labels); since 1.26 with_actions (default true; false: no action row, the index dialog renders Cancel and Create in
    its footer with form="nowo-task-board-create-form"). The form id is `<id_prefix>nowo-task-board-create-form`; the
    action row of a host dialog carries data-nowo-ui-dialog-actions (UiKit's remote dialog moves it to its footer).
#}
{% set _in_dialog = in_dialog|default(false) %}
{% set _id_prefix = id_prefix|default('') %}
{% set _with_actions = with_actions ?? true %}
{% set _step_attr = form.scope is defined ? {'data-controller': 'nowo-task-board-create-steps', 'data-nowo-task-board-create-steps-start-value': (form.scope.vars.data is not empty or form.vars.errors|length > 0 or form.vars.submitted) ? 2 : 1} : {} %}
{{ form_start(form, {action: path(nowo_task_board_route('board_create')), method: 'POST', attr: _step_attr|merge({id: _id_prefix ~ 'nowo-task-board-create-form', class: 'nowo-task-board-create-form' ~ (_in_dialog ? ' nowo-task-dialog__body' : ''), 'data-testid': 'nowo-task-board-create-form'})}) }}
    {{ form_errors(form) }}
    {#- Since 1.30.0 (spec 211): the scope step, only with a host's board.scope_provider. Without JavaScript all of it shows. -#}
    {% set _steps = form.scope is defined %}
    {% if _steps %}
        <div class="nowo-task-board-create__scopes" data-nowo-task-board-create-steps-target="scopes" data-testid="nowo-task-board-create-scopes"{% if form.scope|length == 1 %} hidden{% endif %}>
            {{ form_row(form.scope) }}
            <button type="button" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}" data-action="nowo-task-board-create-steps#next" data-testid="nowo-task-board-create-next">{{ 'task_board.form.board.scope_next'|trans({}, 'NowoTaskBoardBundle') }}</button>
        </div>
    {% endif %}
    {% if _steps %}<div class="nowo-task-board-create__details" data-nowo-task-board-create-steps-target="details" data-testid="nowo-task-board-create-details">{% endif %}
    {% if _steps %}
        {% for _branch in form.scopeFields %}
            <div data-nowo-task-board-create-steps-target="scopeFields" data-scope="{{ _branch.vars.name }}">{{ form_widget(_branch) }}</div>
        {% endfor %}
        {% do form.scopeFields.setRendered() %}
    {% endif %}
    {% for child in form %}
        {% if not child.rendered %}
            {% if form.vars.advanced_slug|default(false) and child.vars.name == 'slug' %}
                <details class="nowo-task-board-create__advanced" data-testid="nowo-task-board-create-advanced"{% if child.vars.errors|length > 0 %} open{% endif %}>
                    <summary>{{ 'task_board.form.board.advanced'|trans({}, 'NowoTaskBoardBundle') }}</summary>
                    {{ _id_prefix is empty ? form_row(child) : form_row(child, {id: _id_prefix ~ child.vars.id}) }}
                </details>
            {% else %}
                {{ _id_prefix is empty or 'hidden' in child.vars.block_prefixes ? form_row(child) : form_row(child, {id: _id_prefix ~ child.vars.id}) }}
            {% endif %}
        {% endif %}
    {% endfor %}
    {% if _steps %}</div>{% endif %}
    {% if _with_actions %}
        <div class="nowo-task-dialog__actions"{% if _in_dialog %} data-nowo-ui-dialog-actions{% endif %}>
            {% if _in_dialog and form.scope is defined %}
                {#- Interim: a host's remote dialog lifts this row to its footer. UiKit's lift to the header uses the same attribute. -#}
                <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-nowo-ui-dialog-back data-nowo-task-board-create-form="{{ _id_prefix ~ 'nowo-task-board-create-form' }}" hidden>{{ 'task_board.action.back'|trans({}, 'NowoTaskBoardBundle') }}</button>
            {% endif %}
            {% if _in_dialog %}
                <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-nowo-ui-dialog-close>{{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}</button>
            {% endif %}
            <button type="submit" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}" data-testid="nowo-task-board-create-submit">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'plus'}) }}{{ 'task_board.action.create'|trans({}, 'NowoTaskBoardBundle') }}
            </button>
        </div>
    {% endif %}
{{ form_end(form) }}
