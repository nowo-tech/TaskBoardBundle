{#
    Add / edit link dialog. Since 1.14 a native <dialog> styled by task-board.css (no CSS framework modal). Since 1.26
    (dialog rule v2) the footer sits outside the scrolling form: Remove link (secondary, danger outline, edit only) on
    the left, Cancel and Save (form="nowo-task-link-form") on the right.
#}
{% set _body %}
    {{ form_start(linkForm, {
        action: path(nowo_task_board_route('task_link'), {taskId: task.id}|merge(taskRouteExtra|default({}))),
        method: 'POST',
        attr: {
            id: 'nowo-task-link-form',
            class: 'nowo-task-dialog__body',
            'data-nowo-task-board-task-links-modal-target': 'form',
        },
    }) }}
        <div class="nowo-task-dialog__grid nowo-task-dialog__grid--narrow-first">
            <div class="nowo-task-field">{{ form_row(linkForm.linkType, {attr: {'data-nowo-task-board-task-links-modal-target': 'linkType'}}) }}</div>
            <div class="nowo-task-field">{{ form_row(linkForm.url, {attr: {'data-nowo-task-board-task-links-modal-target': 'url'}}) }}</div>
        </div>
        <div class="nowo-task-dialog__grid">
            <div class="nowo-task-field">{{ form_row(linkForm.label, {attr: {'data-nowo-task-board-task-links-modal-target': 'label'}}) }}</div>
            <div class="nowo-task-field">{{ form_row(linkForm.externalId, {attr: {'data-nowo-task-board-task-links-modal-target': 'externalId'}}) }}</div>
        </div>
        {% for child in linkForm %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(linkForm) }}
    {# REQ-TWIG-005: the links modal controller sets the action per link before submitting. #}
    {{ form_start(linkRemoveForm, {action: '#', attr: {id: 'nowo-task-link-delete-form', hidden: 'hidden', 'data-nowo-task-board-task-links-modal-target': 'deleteForm', 'data-confirm': 'task_board.task.link_delete_confirm'|trans({}, 'NowoTaskBoardBundle')}}) }}
        {% for child in linkRemoveForm %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(linkRemoveForm) }}
{% endset %}
{% set _footer %}
        <button
            type="submit"
            form="nowo-task-link-delete-form"
            class="{{ nowo_ui_class('btn_danger', 'NowoTaskBoardBundle') }} nowo-task-btn-danger"
            hidden
            data-nowo-task-board-task-links-modal-target="deleteButton"
        >
            {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'trash'}) }}{{ 'task_board.action.remove_link'|trans({}, 'NowoTaskBoardBundle') }}
        </button>
        <div class="nowo-task-dialog__actions-end">
            <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoTaskBoardBundle') }}" data-nowo-ui-dialog-close>
                {{ 'task_board.action.cancel'|trans({}, 'NowoTaskBoardBundle') }}
            </button>
            <button type="submit" form="nowo-task-link-form" class="{{ nowo_ui_class('btn_primary', 'NowoTaskBoardBundle') }}">
                {{ include('@NowoTaskBoardBundle/manage/_icon.html.twig', {name: 'device-floppy'}) }}{{ 'task_board.action.save'|trans({}, 'NowoTaskBoardBundle') }}
            </button>
        </div>
{% endset %}
{{ include(nowo_ui_partial('dialog', 'NowoTaskBoardBundle'), {
    id: 'nowo-task-board-task-links-modal' ~ '-' ~ task.id,
    title: 'task_board.task.links_modal_add_title'|trans({}, 'NowoTaskBoardBundle'),
    bundle: 'NowoTaskBoardBundle',
    root_class: 'nowo-task-dialog nowo-task-dialog--native nowo-task-dialog--wide',
    size: 'wide',
    attr: {'data-nowo-task-board-task-links-modal-target': 'modal'},
    title_attr: {'data-nowo-task-board-task-links-modal-target': 'title'},
    body: _body,
    footer: _footer,
    footer_attr: {class: 'nowo-task-dialog__footer nowo-task-dialog__actions nowo-task-dialog__actions--split'},
}, false) }}
